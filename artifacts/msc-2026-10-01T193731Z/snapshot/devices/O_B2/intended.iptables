*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]
-A INPUT -i lo -p tcp -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A OUTPUT -p tcp -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A INPUT -i lo -p udp -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A OUTPUT -p udp -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A INPUT -i lo -p esp -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A OUTPUT -p esp -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A INPUT -i lo -p icmp -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A OUTPUT -p icmp -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A INPUT -i mgmt -s 172.30.119.10 -p icmp -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A INPUT -i mgmt -s 172.30.119.10 -p tcp --dport 8443 -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A INPUT -i black -s 172.20.12.1 -d 172.20.22.1 -p udp -m multiport --dports 500,4500 -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A INPUT -i black -s 172.20.12.1 -d 172.20.22.1 -p esp -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A FORWARD -i gray -o black -s 10.200.2.2/32 -d 10.100.2.2/32 -p esp -m policy --dir out --pol ipsec --mode tunnel --reqid 202 -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A FORWARD -i black -o gray -s 10.100.2.2/32 -d 10.200.2.2/32 -p esp -m policy --dir in --pol ipsec --mode tunnel --reqid 202 -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A FORWARD -i gray -o black -s 10.200.2.2/32 -d 10.100.2.2/32 -p udp -m multiport --dports 500,4500 -m policy --dir out --pol ipsec --mode tunnel --reqid 202 -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
-A FORWARD -i black -o gray -s 10.100.2.2/32 -d 10.200.2.2/32 -p udp -m multiport --dports 500,4500 -m policy --dir in --pol ipsec --mode tunnel --reqid 202 -m u32 --u32 "0>>0x18&0xf=0x5" -j ACCEPT
COMMIT
