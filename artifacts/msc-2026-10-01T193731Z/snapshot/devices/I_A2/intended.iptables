*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]
-A INPUT -i lo -p tcp -j ACCEPT
-A OUTPUT -p tcp -j ACCEPT
-A INPUT -i lo -p udp -j ACCEPT
-A OUTPUT -p udp -j ACCEPT
-A INPUT -i lo -p esp -j ACCEPT
-A OUTPUT -p esp -j ACCEPT
-A INPUT -i lo -p icmp -j ACCEPT
-A OUTPUT -p icmp -j ACCEPT
-A INPUT -i mgmt -s 172.30.12.10 -p icmp -j ACCEPT
-A INPUT -i mgmt -s 172.30.12.10 -p tcp --dport 8443 -j ACCEPT
-A INPUT -i gray -s 10.200.2.2 -d 10.100.2.2 -p udp -m multiport --dports 500,4500 -j ACCEPT
-A INPUT -i gray -s 10.200.2.2 -d 10.100.2.2 -p esp -j ACCEPT
-A FORWARD -i red -o gray -s 10.1.2.0/24 -d 10.2.2.0/24 -p tcp -m policy --dir out --pol ipsec --mode tunnel --reqid 102 -j ACCEPT
-A FORWARD -i gray -o red -s 10.2.2.0/24 -d 10.1.2.0/24 -p tcp -m policy --dir in --pol ipsec --mode tunnel --reqid 102 -j ACCEPT
-A FORWARD -i red -o gray -s 10.1.2.0/24 -d 10.2.2.0/24 -p udp -m policy --dir out --pol ipsec --mode tunnel --reqid 102 -j ACCEPT
-A FORWARD -i gray -o red -s 10.2.2.0/24 -d 10.1.2.0/24 -p udp -m policy --dir in --pol ipsec --mode tunnel --reqid 102 -j ACCEPT
-A FORWARD -i red -o gray -s 10.1.2.0/24 -d 10.2.2.0/24 -p esp -m policy --dir out --pol ipsec --mode tunnel --reqid 102 -j ACCEPT
-A FORWARD -i gray -o red -s 10.2.2.0/24 -d 10.1.2.0/24 -p esp -m policy --dir in --pol ipsec --mode tunnel --reqid 102 -j ACCEPT
-A FORWARD -i red -o gray -s 10.1.2.0/24 -d 10.2.2.0/24 -p icmp -m policy --dir out --pol ipsec --mode tunnel --reqid 102 -j ACCEPT
-A FORWARD -i gray -o red -s 10.2.2.0/24 -d 10.1.2.0/24 -p icmp -m policy --dir in --pol ipsec --mode tunnel --reqid 102 -j ACCEPT
COMMIT
