*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -i mgmt -s 172.30.119.10 -p icmp -j ACCEPT
-A INPUT -i mgmt -s 172.30.119.10 -p tcp --dport 8443 -j ACCEPT
-A INPUT -i black -s 172.20.11.1 -d 172.20.21.1 -p udp -m multiport --dports 500,4500 -j ACCEPT
-A INPUT -i black -s 172.20.11.1 -d 172.20.21.1 -p esp -j ACCEPT
-A FORWARD -i gray -o black -s 10.200.1.2/32 -d 10.100.1.2/32 -p esp -m policy --dir out --pol ipsec --mode tunnel --reqid 201 -j ACCEPT
-A FORWARD -i black -o gray -s 10.100.1.2/32 -d 10.200.1.2/32 -p esp -m policy --dir in --pol ipsec --mode tunnel --reqid 201 -j ACCEPT
-A FORWARD -i gray -o black -s 10.200.1.2/32 -d 10.100.1.2/32 -p udp -m multiport --dports 500,4500 -m policy --dir out --pol ipsec --mode tunnel --reqid 201 -j ACCEPT
-A FORWARD -i black -o gray -s 10.100.1.2/32 -d 10.200.1.2/32 -p udp -m multiport --dports 500,4500 -m policy --dir in --pol ipsec --mode tunnel --reqid 201 -j ACCEPT
COMMIT
