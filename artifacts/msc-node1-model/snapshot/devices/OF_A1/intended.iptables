*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -i mgmt -s 172.30.109.10 -p icmp -j ACCEPT
-A INPUT -i mgmt -s 172.30.109.10 -p tcp --dport 8443 -j ACCEPT
-A INPUT -i outside -s 172.21.11.2 -p ospf -j ACCEPT
-A FORWARD -i inside -o outside -s 172.20.11.1 -d 172.20.21.1 -p esp -j ACCEPT
-A FORWARD -i inside -o outside -s 172.20.11.1 -d 172.20.21.1 -p udp -m multiport --dports 500,4500 -j ACCEPT
-A FORWARD -i outside -o inside -s 172.20.21.1 -d 172.20.11.1 -p esp -j ACCEPT
-A FORWARD -i outside -o inside -s 172.20.21.1 -d 172.20.11.1 -p udp -m multiport --dports 500,4500 -j ACCEPT
COMMIT
