driver=macsec_linux
interface=eth0
ssid=msc-auth
ieee8021x=1
use_pae_group_addr=1
eap_server=0
own_ip_addr=10.88.0.1
nas_identifier=P1
auth_server_addr=10.88.0.2
auth_server_port=1812
auth_server_shared_secret=[REDACTED_RADIUS_SECRET]
macsec_policy=1
macsec_integ_only=0
macsec_csindex=1
macsec_replay_protect=1
macsec_replay_window=0
mka_priority=0
logger_stdout=-1
logger_stdout_level=1
