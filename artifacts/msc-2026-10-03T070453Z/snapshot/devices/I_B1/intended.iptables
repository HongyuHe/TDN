*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]
-A INPUT -i lo -p tcp -j ACCEPT
-A OUTPUT -o lo -p tcp -j ACCEPT
-A INPUT -i lo -p udp -j ACCEPT
-A OUTPUT -o lo -p udp -j ACCEPT
-A INPUT -i lo -p esp -j ACCEPT
-A OUTPUT -o lo -p esp -j ACCEPT
-A INPUT -i lo -p icmp -j ACCEPT
-A OUTPUT -o lo -p icmp -j ACCEPT
-A INPUT -i mgmt -s 172.30.21.10 -p icmp -j ACCEPT
-A INPUT -i mgmt -s 172.30.21.10 -p tcp --dport 8443 -j ACCEPT
-A OUTPUT -o mgmt -d 172.30.21.10 -p icmp -j ACCEPT
-A OUTPUT -o mgmt -d 172.30.21.10 -p tcp --sport 8443 -j ACCEPT
-A OUTPUT -o gray -s 10.200.1.2 -d 10.100.1.2 -p udp -m multiport --dports 500,4500 -j ACCEPT
-A OUTPUT -o gray -s 10.200.1.2 -d 10.100.1.2 -p esp -j ACCEPT
-A INPUT -i gray -s 10.100.1.2 -d 10.200.1.2 -p udp -m multiport --dports 500,4500 -j ACCEPT
-A INPUT -i gray -s 10.100.1.2 -d 10.200.1.2 -p esp -j ACCEPT
-A FORWARD -i red -o gray -s 10.2.1.0/24 -d 10.1.1.0/24 -p tcp -m policy --dir out --pol ipsec --mode tunnel --reqid 101 -j ACCEPT
-A FORWARD -i gray -o red -s 10.1.1.0/24 -d 10.2.1.0/24 -p tcp -m policy --dir in --pol ipsec --mode tunnel --reqid 101 -j ACCEPT
-A FORWARD -i red -o gray -s 10.2.1.0/24 -d 10.1.1.0/24 -p udp -m policy --dir out --pol ipsec --mode tunnel --reqid 101 -j ACCEPT
-A FORWARD -i gray -o red -s 10.1.1.0/24 -d 10.2.1.0/24 -p udp -m policy --dir in --pol ipsec --mode tunnel --reqid 101 -j ACCEPT
-A FORWARD -i red -o gray -s 10.2.1.0/24 -d 10.1.1.0/24 -p esp -m policy --dir out --pol ipsec --mode tunnel --reqid 101 -j ACCEPT
-A FORWARD -i gray -o red -s 10.1.1.0/24 -d 10.2.1.0/24 -p esp -m policy --dir in --pol ipsec --mode tunnel --reqid 101 -j ACCEPT
-A FORWARD -i red -o gray -s 10.2.1.0/24 -d 10.1.1.0/24 -p icmp -m policy --dir out --pol ipsec --mode tunnel --reqid 101 -j ACCEPT
-A FORWARD -i gray -o red -s 10.1.1.0/24 -d 10.2.1.0/24 -p icmp -m policy --dir in --pol ipsec --mode tunnel --reqid 101 -j ACCEPT
COMMIT
