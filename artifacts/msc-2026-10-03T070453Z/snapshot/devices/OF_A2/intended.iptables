*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT
-A INPUT -i mgmt -s 172.30.109.10 -p icmp -j ACCEPT
-A INPUT -i mgmt -s 172.30.109.10 -p tcp --dport 8443 -j ACCEPT
-A OUTPUT -o mgmt -d 172.30.109.10 -p icmp -j ACCEPT
-A OUTPUT -o mgmt -d 172.30.109.10 -p tcp --sport 8443 -j ACCEPT
-A INPUT -i outside -s 172.21.12.2 -d 172.21.12.1 -p ospf -j ACCEPT
-A INPUT -i outside -s 172.21.12.2 -d 224.0.0.5 -p ospf -j ACCEPT
-A OUTPUT -o outside -s 172.21.12.1 -d 172.21.12.2 -p ospf -j ACCEPT
-A OUTPUT -o outside -s 172.21.12.1 -d 224.0.0.5 -p ospf -j ACCEPT
-A FORWARD -i inside -o outside -s 172.20.12.1 -d 172.20.22.1 -p esp -j ACCEPT
-A FORWARD -i inside -o outside -s 172.20.12.1 -d 172.20.22.1 -p udp -m multiport --dports 500,4500 -j ACCEPT
-A FORWARD -i outside -o inside -s 172.20.22.1 -d 172.20.12.1 -p esp -j ACCEPT
-A FORWARD -i outside -o inside -s 172.20.22.1 -d 172.20.12.1 -p udp -m multiport --dports 500,4500 -j ACCEPT
COMMIT
