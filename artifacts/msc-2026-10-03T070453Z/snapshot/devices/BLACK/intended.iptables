*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -i lo -j ACCEPT
-A INPUT -i p11 -s 172.21.11.1 -p ospf -j ACCEPT
-A INPUT -i p12 -s 172.21.12.1 -p ospf -j ACCEPT
-A INPUT -i p21 -s 172.21.21.1 -p ospf -j ACCEPT
-A INPUT -i p22 -s 172.21.22.1 -p ospf -j ACCEPT
-A INPUT -p icmp -j ACCEPT
-A FORWARD -j ACCEPT
COMMIT
