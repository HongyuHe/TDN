ARG BASE_IMAGE=tdn-hostap-pq:20261024-v3
FROM ${BASE_IMAGE}
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nftables iproute2 iputils-ping python3 procps && rm -rf /var/lib/apt/lists/*
COPY wpa_supplicant /usr/local/sbin/wpa_supplicant
RUN /usr/local/sbin/wpa_supplicant -v && nft --version
