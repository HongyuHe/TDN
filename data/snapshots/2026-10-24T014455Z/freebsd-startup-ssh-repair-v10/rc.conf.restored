hostname="freebsd"
firstboot_freebsd_update_enable=YES
growfs_enable=YES
sshd_enable=YES
nuageinit_enable="NO"
dumpdev="AUTO"
ifconfig_DEFAULT="SYNCDHCP accept_rtadv"
sshd_enable="YES"
kld_list="ipsec"
pf_enable="YES"
gateway_enable="YES"
ifconfig_vtnet1="down"
ifconfig_vtnet2="inet 10.1.1.1/24 mtu 1320"
ifconfig_vtnet3="inet 10.100.1.2/24 mtu 1400"
static_routes="tdn_red tdn_gray"
route_tdn_red="-net 10.2.1.0/24 10.100.1.1"
route_tdn_gray="-host 10.200.1.2 10.100.1.1"
tdn_gateway_enable="YES"
