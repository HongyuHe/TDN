    <tdn:leanReference>EncapsulationUse at TDN/Requirements/CoreMscRequirements.lean:202</tdn:leanReference>
    <tdn:leanReference>MACsecEncapsulationCore at TDN/Requirements/CoreMscRequirements.lean:214</tdn:leanReference>
    <tdn:leanReference>MscComplianceContext.AllApplicableDuties at TDN/Requirements/CsfcRoleObligations.lean:424</tdn:leanReference>
    <tdn:leanReference>msc_macsec_encapsulation at TDN/Requirements/MasterMscRequirementSpecs.lean:27</tdn:leanReference>
    <tdn:leanRepresentation>composed</tdn:leanRepresentation>
    <tdn:may_be_realized_as rdf:resource="urn:tdn:csfc:msc:roles:ROLE-router" />
    <tdn:may_be_realized_as rdf:resource="urn:tdn:csfc:msc:roles:ROLE-switch" />
    <tdn:roleId>ROLE-encapsulation-device</tdn:roleId>
    <tdn:roleKind>device_or_service_role</tdn:roleKind>
