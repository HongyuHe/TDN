    <rdfs:subClassOf rdf:resource="urn:tdn:csfc:msc:roles:ExtractedRole" />
    <skos:altLabel>Encapsulation/ Decapsulation Device</skos:altLabel>
    <skos:altLabel>standalone device</skos:altLabel>
    <skos:altLabel>standalone router or switch</skos:altLabel>
