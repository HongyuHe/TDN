  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:ROLE-registration-authority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment>Mixed hardware, software, and personnel authority collecting and submitting certificate information; device realization is unspecified.</rdfs:comment>
    <rdfs:label>Registration Authority</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:tdn:csfc:msc:roles:ExtractedRole" />
