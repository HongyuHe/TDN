  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:ExtractedRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment>Analyst-defined organizational superclass for realizations of the role and concept categories extracted from the CSfC MSC v1.3.0 source. Each role class denotes the entities or bearers that realize its source-context category. The categories include devices, services, aggregates, mixed authorities, and protocol functions. The root does not reproduce a CP definition and does not assert that every category is a physical device or an MSC Solution Component. Classes without a curated parent receive a generated organizational edge to the root; that edge is separate from source-backed subtype evidence.</rdfs:comment>
    <rdfs:label>Extracted role or concept realization</rdfs:label>
    <tdn:roleId>ExtractedRole</tdn:roleId>
    <tdn:roleKind>analyst_organization</tdn:roleKind>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-001">
    <rdfs:label>Applicable requirements and policy precedence</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:216
| 1 =&gt; external [.localPolicyAndUSGovernmentGuidance, .cnssPolicy, .policyConflictsReported]</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>The context must contain external confirmations that local and government guidance, CNSS policy, and the duty to report policy conflicts have been met.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-002">
    <rdfs:label>Validated configuration and component modification</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:217
| 2 =&gt; each (fun device record =&gt;
      records.external.Confirms .evaluatedProductConfiguration
        (.product device.id record.product record.version device.kind) ∧
      (record.modified = true → records.external.Confirms
        .niapModificationDoesNotAlterCertification (.component device.id)))</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>Each component must have confirmation that its product and version match an evaluated configuration. A modified component also needs confirmation that the modification preserves certification.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-003">
    <rdfs:label>Product eligibility on the CSfC Components List</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:222
| 3 =&gt; each (fun device record =&gt; device.kind ∈
      [.vpn, .macsec, .grayFirewall, .outerFirewall, .innerFirewall, .authenticationServer, .intrusionPrevention] →
      records.external.Confirms .componentsListEligibility
        (.product device.id record.product record.version device.kind))</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>Components of the listed kinds need external confirmation that their product and version are eligible on the CSfC Components List.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-004">
    <rdfs:label>Independent product, operating-system, and cryptographic implementations</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:401
def IndependentComponents (records : TechnicalDutyRecords) (d : Deployment) : Prop :=
  ∀ inner ∈ d.devices, inner.layer = some .inner →
    ∀ other ∈ d.devices, (d.Relevant inner.id ∨ d.Relevant other.id) →
    other.layer = some .outer ∨ other.kind = .grayFirewall →
    ∀ first ∈ records.components, ∀ second ∈ records.components,
      first.component = inner.id → second.component = other.id →
      first.physicalDevice ≠ second.physicalDevice ∧
      (IndependentManufacturers first second ∨
        (first.product ≠ second.product ∧ records.external.Confirms
          .nsaIndependenceApproval (.componentPair inner.id other.id))) ∧
      (other.layer = some .outer →
        first.operatingSystemFamily ≠ second.operatingSystemFamily ∧
        IndependentCryptographicLibraries records first second)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:226
| 4 =&gt; IndependentComponents records d</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Inner encryptors must use different physical devices from Outer encryptors and Gray Firewalls. The component records must show independent manufacturers, or different products with explicit NSA approval. Inner and Outer encryptors also need different operating-system families and the specified cryptographic-library independence.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-005">
    <rdfs:label>Physical separation of security components</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:415
def PhysicalRoleSeparation (records : TechnicalDutyRecords) (d : Deployment) : Prop :=
  ∀ first ∈ records.components, ∀ second ∈ records.components,
    first.component ≠ second.component → (d.Relevant first.component ∨ d.Relevant second.component) →
    (d.IsLayer first.component .inner ∧ d.IsLayer second.component .outer ∨
      d.IsDevice first.component .grayFirewall ∧
        (d.IsLayer second.component .inner ∨ d.IsLayer second.component .outer)) →
    first.physicalDevice ≠ second.physicalDevice</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:227
| 5 =&gt; PhysicalRoleSeparation records d</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>An Inner and Outer encryptor must not share a physical device. A Gray Firewall must also use a physical device distinct from either encryption layer.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-006">
    <rdfs:label>Product Supply Chain Threat Assessment</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:228
| 6 =&gt; each (fun device record =&gt;
      records.external.Confirms .supplyChainThreatAssessment
        (.product device.id record.product record.version device.kind) ∧
      records.external.Confirms .supplyChainMitigation
        (.product device.id record.product record.version device.kind))</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>Each component needs external confirmations of a supply-chain threat assessment and the required mitigation.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-007">
    <rdfs:label>Two independent encryption layers and allowed tunnel pairings</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:66
def CoreReq_msc_nested_layer_protection {S A : Type} (d : Deployment) (model : ForwardingModel S A)
    (flows : List Flow) (flowOf : S → List A → S → PayloadId → Flow) (independentKeys : String → String → Prop) : Prop :=
  model.CoversDeployment d ∧ ArchitectureServices d ∧
  (∀ flow ∈ flows, flow.Valid d independentKeys) ∧
  (∀ start actions finish, model.initial start → model.system.MTr start actions finish →
    let events := model.TraceEvents actions
    let selectedFlow := flowOf start actions finish
    (∀ payload network, .inject payload network ∈ events →
      selectedFlow payload ∈ flows ∧ (selectedFlow payload).sourceNetwork = network) ∧
    (∀ earlier later payload iface layers trafficClass,
      events = earlier ++ [.transmit payload iface layers trafficClass] ++ later →
      model.ProtectedPayload d payload →
      ∀ interface ∈ d.interfaces, d.Relevant interface.device → interface.id = iface →
      (interface.zone = .gray → selectedFlow payload ∈ flows ∧ layers = [(selectedFlow payload).innerTunnel] ∧
        .encrypt payload (selectedFlow payload).innerTunnel ∈ earlier) ∧
      (interface.zone = .black → selectedFlow payload ∈ flows ∧
        layers = [(selectedFlow payload).outerTunnel, (selectedFlow payload).innerTunnel] ∧
        Before earlier (.encrypt payload (selectedFlow payload).innerTunnel)
          (.encrypt payload (selectedFlow payload).outerTunnel))) ∧
    (∀ payload iface layers trafficClass, .receive payload iface layers trafficClass ∈ events →
      model.ProtectedPayload d payload →
      ∀ interface ∈ d.interfaces, d.Relevant interface.device → interface.id = iface → interface.zone = .black →
      selectedFlow payload ∈ flows ∧
      layers = [(selectedFlow payload).outerTunnel, (selectedFlow payload).innerTunnel]) ∧
    ∀ earlier later payload network layers,
      events = earlier ++ [.deliver payload network layers] ++ later →
      .inject payload (selectedFlow payload).sourceNetwork ∈ earlier → CrossedBlack d earlier payload →
      selectedFlow payload ∈ flows ∧ network = (selectedFlow payload).destinationNetwork ∧ layers = [] ∧
      Before earlier (.decrypt payload (selectedFlow payload).outerTunnel)
        (.decrypt payload (selectedFlow payload).innerTunnel))</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:6
def msc_nested_layer_protection {S A : Type} (d : Deployment) (model : ForwardingModel S A)
    (flows : List Flow) (flowOf : S → List A → S → PayloadId → Flow) (independentKeys : String → String → Prop) : Prop :=
  CoreReq_msc_nested_layer_protection { d with focus := none } model flows flowOf independentKeys</tdn:requirementCode>
    <tdn:requirementStatus>Complete proof unfinished</tdn:requirementStatus>
    <tdn:requirementTranslation>Every modeled trace must use the declared Inner and Outer tunnel pairing for protected Red payloads. Gray transmission carries the Inner layer; Black transmission and reception carry both layers. Inner encryption precedes Outer encryption, and receiving-side decryption removes Outer before Inner. The definition also requires complete model coverage, independent key contexts, suitable peer placement, and the required authentication and architecture services.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-008">
    <rdfs:label>Connectivity restricted to the same security level</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:97
def SecurityLevelConnectivityCore {S A : Type} (d : Deployment)
    (model : ForwardingModel S A) (authenticatedInnerPairs establishedInnerTunnels : List (String × String))
    (requiredConnectivity : List (String × String)) (includedUnclassified : List String) : Prop :=
  model.CoversDeployment d ∧
  DedicatedInnerAssignments d.networks ∧
  (∀ network ∈ d.networks, ∀ inner ∈ network.innerComponents,
    ∃ device ∈ d.devices, device.id = inner ∧ device.layer = some .inner ∧
      device.level = network.level) ∧
  (∀ pair ∈ authenticatedInnerPairs ++ establishedInnerTunnels,
    ∃ first ∈ d.devices, ∃ second ∈ d.devices,
      first.id = pair.1 ∧ second.id = pair.2 ∧ first.layer = some .inner ∧
      second.layer = some .inner ∧ first.level = second.level) ∧
  (model.AllTraces (fun events =&gt; ∀ payload source destination layers,
    Before events (.inject payload source) (.deliver payload destination layers) →
    ∃ first ∈ d.networks, ∃ second ∈ d.networks,
      first.id = source ∧ second.id = destination ∧ first.level = second.level)) ∧
  (∀ pair ∈ requiredConnectivity, ∃ start actions finish payload,
    model.initial start ∧ model.system.MTr start actions finish ∧
    Before (model.TraceEvents actions) (.inject payload pair.1) (.deliver payload pair.2 [])) ∧
  ∀ network ∈ includedUnclassified,
    (∃ red ∈ d.networks, red.id = network ∧ red.level.classification = "unclassified")</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:10
def msc_security_level_connectivity {S A : Type} (context : MscComplianceContext S A) : Prop :=
  SecurityLevelConnectivityCore { context.deployment with focus := none } context.model
    context.authenticatedInnerPairs context.establishedInnerTunnels context.requiredConnectivity
    context.includedUnclassified ∧
  (∃ contexts, context ∈ contexts ∧ MSCReferencesClosed contexts) ∧
  ∀ network ∈ context.includedUnclassified, context.AllApplicableDuties (.enclaveNetwork network)</tdn:requirementCode>
    <tdn:requirementStatus>Complete proof unfinished</tdn:requirementStatus>
    <tdn:requirementTranslation>Each Red network has dedicated Inner components with matching security levels. Authenticated Inner pairs and established Inner tunnels stay within one level, and every delivered payload stays within its source level. Required connectivity pairs must have a successful execution. Included unclassified networks also satisfy the applicable duties, and references to other MSC solutions must be accounted for.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-009">
    <rdfs:label>Gray-network control and classification boundary</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:233
| 9 =&gt; external [.trustedRedGrayControl, .grayUnclassifiedDetermination]</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>The context needs external confirmation that Red and Gray networks are under trusted control and that Gray information has been classified as unclassified.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-010">
    <rdfs:label>Independently managed site administration and trust</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:234
| 10 =&gt; (records.independentlyManaged = true →
      (∀ record ∈ records.components, ∀ connection ∈ record.managementConnections,
        connection.crossesBlack = false) ∧
      (∀ tunnel ∈ d.tunnels, tunnel.mechanism = .ipsec →
        ∃ first ∈ records.certificates, ∃ second ∈ records.certificates,
          first.subject = tunnel.sender ∧ second.subject = tunnel.receiver ∧
          first.issuer ∈ second.chain ∧ second.issuer ∈ first.chain))</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>When independently managed operation is selected, recorded management connections must stay off Black. Each IPsec tunnel's two peers must have certificate chains that trust the other's issuer.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-011">
    <rdfs:label>Central management, CA placement, and intersite protection</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:455
def CentralManagementConfiguration (records : TechnicalDutyRecords) (d : Deployment) : Prop :=
  ∀ site, d.centralManagementSite = some site →
    (∀ component ∈ d.devices, d.certificateAuthenticated component.id = true →
      ∃ authority ∈ d.devices, authority.kind = .certificationAuthority ∧
        authority.site = site ∧ d.keyManagementCA component.id authority.id) ∧
    (∀ first ∈ d.devices, ∀ second ∈ d.devices,
      first.layer = some .inner → second.layer = some .outer →
      d.certificateAuthenticated first.id = true → d.certificateAuthenticated second.id = true →
      ∀ firstCA secondCA, d.keyManagementCA first.id firstCA →
        d.keyManagementCA second.id secondCA → firstCA ≠ secondCA) ∧
    (∀ component ∈ d.devices, component.kind = .macsec →
      d.certificateAuthenticated component.id = true →
      ∃ server ∈ d.devices, server.kind = .authenticationServer ∧ server.site = site) ∧
    (∀ record ∈ records.components, ∀ connection ∈ record.managementConnections,
      connection.crossesBlack = true → 2 ≤ connection.approvedEncryptionLayers) ∧
    (∀ record ∈ records.components, record.managementConnections ≠ [] →
      record.managementCryptographicSeparated = true)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:241
| 11 =&gt; CentralManagementConfiguration records d</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>When a central management site is declared, certificate-authenticated components need a CA at that site, and Inner and Outer components use distinct CAs. Certificate-authenticated MACsec devices also need an Authentication Server there. Recorded management connections crossing Black use at least two approved encryption layers, and components with management connections have cryptographic separation enabled.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-012">
    <rdfs:label>Separate authentication and management for security levels</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:119
def CoreReq_msc_security_level_key_and_management_separation (managementDeployed : Bool)
    (peers : List InnerAuthentication) (establishedTunnel : String → String → Prop) : Prop :=
  TDN.Requirements.msc_security_level_key_and_management_separation managementDeployed peers ∧
  ∀ a ∈ peers, ∀ b ∈ peers, a.level ≠ b.level → ¬ establishedTunnel a.component b.component</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CrossEnclavePkiIsolationSpec.lean:33
def msc_security_level_key_and_management_separation
    (managementSelected : Bool) (peers : List InnerAuthentication) : Prop :=
  (managementSelected = true → ∀ a ∈ peers, a.managementDevices.Nonempty) ∧
  (∀ a ∈ peers, ∀ b ∈ peers, a.level ≠ b.level →
    MaterialsSeparated a b ∧
    (managementSelected = true → Disjoint a.managementDevices b.managementDevices) ∧
    ¬ InnerCanAuthenticate a b)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:17
def msc_security_level_key_and_management_separation :=
  CoreReq_msc_security_level_key_and_management_separation</tdn:requirementCode>
    <tdn:requirementStatus>Complete model proof reviewed</tdn:requirementStatus>
    <tdn:requirementTranslation>Inner peers at different levels must use separated authentication material, must not authenticate each other, and must have no established tunnel between them. When management is deployed, each peer has management devices and different levels use disjoint management-device sets.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-013">
    <rdfs:label>Gray Firewalls on all paths needing level separation</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:151
def CoreReq_msc_gray_firewall_path_coverage (d : Deployment) (topology : GrayTopology) : Prop :=
  d.AddressInventoryCoherent ∧
  (∀ node, topology.inner node ↔ d.IsLayer node .inner) ∧
  (∀ node, topology.grayFirewall node ↔ d.IsDevice node .grayFirewall) ∧
  (∀ node, topology.outer node ↔ d.IsLayer node .outer) ∧
  (∀ node, topology.workstation node ↔ d.grayWorkstation node) ∧
  (∀ node, topology.localCA node → topology.certificationAuthority node) ∧
  (∀ node, topology.certificationAuthority node ↔
    d.IsDevice node .certificationAuthority ∧
      ∃ interface ∈ d.interfaces, interface.device = node ∧ interface.zone = .gray) ∧
  (∀ node, topology.revocationService node ↔
    d.IsDevice node .revocationService ∧
      ∃ interface ∈ d.interfaces, interface.device = node ∧ interface.zone = .gray) ∧
  (∀ device ∈ d.devices, d.Relevant device.id → topology.level device.id = device.level) ∧
  TDN.Requirements.msc_gray_firewall_path_coverage topology.edge topology.grayFirewall topology.inner
    (GrayManagement topology) topology.level topology.highest topology.dominates
    (FiltersIntendedPeers d) d.authority.protectsAsClassified ∧
  (∀ service component,
    (topology.workstation service ∨ topology.certificationAuthority service ∨
      topology.revocationService service) → topology.inner component →
    topology.level service ≠ topology.level component →
    ¬ Relation.ReflTransGen (Waypointing.Avoiding topology.edge topology.grayFirewall) service component) ∧
  (∀ outer, topology.outer outer → FiltersIntendedPeers d outer) ∧
  (∀ firewall, topology.grayFirewall firewall → ∀ interface ∈ d.interfaces, d.Relevant interface.device →
    interface.device = firewall → ∀ direction traffic,
      d.Accepts interface.id direction traffic →
      ∀ manager component, GrayManagement topology manager → topology.inner component →
        topology.level component ≠ topology.highest →
        ¬ ((traffic.sourceDevice = some manager ∧ traffic.destinationDevice = some component) ∨
          (traffic.sourceDevice = some component ∧ traffic.destinationDevice = some manager))) ∧
  ∀ firewall, topology.grayFirewall firewall → ∃ outer inner,
    topology.outer outer ∧ topology.inner inner ∧
    Relation.ReflTransGen topology.edge inner firewall ∧
    Relation.ReflTransGen topology.edge firewall outer</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:20
def msc_gray_firewall_path_coverage (d : Deployment) (topology : GrayTopology) : Prop :=
  CoreReq_msc_gray_firewall_path_coverage { d with focus := none } topology</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MscFirewallWaypointingTheorems.lean:90
def msc_gray_firewall_path_coverage {Node Label : Type}
    (grayEdge : Node → Node → Prop) (grayFirewall inner management : Node → Prop)
    (level : Node → Label) (highest : Label) (dominates : Label → Label → Prop)
    (filtersIntendedSameLevel physicallyProtected : Node → Prop) : Prop :=
  (∀ a b, inner a → inner b → level a ≠ level b →
    ¬ Relation.ReflTransGen (Waypointing.Avoiding grayEdge grayFirewall) a b) ∧
  (∀ administrator component, management administrator → inner component →
    level component ≠ highest →
      ¬ Relation.ReflTransGen (Waypointing.Avoiding grayEdge grayFirewall) administrator component) ∧
  (∀ administrator, management administrator → level administrator = highest) ∧
  (∀ component, inner component → dominates highest (level component)) ∧
  (∀ firewall, grayFirewall firewall →
    filtersIntendedSameLevel firewall ∧ physicallyProtected firewall) ∧
  ((∃ a b, inner a ∧ inner b ∧ level a ≠ level b) → ∃ firewall, grayFirewall firewall)</tdn:requirementCode>
    <tdn:requirementStatus>Complete model proof reviewed</tdn:requirementStatus>
    <tdn:requirementTranslation>Every Gray path that crosses the specified security-level boundary must pass through a Gray Firewall. The modeled roles and levels must match the device records. Firewalls and Outer components filter Inner peers by level; Gray management and certificate services have the stated placement and separation conditions. Each Gray Firewall must also lie on an actual Inner-to-Outer path.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-014">
    <rdfs:label>Gray addressing supports security-level filtering</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:186
def CoreReq_msc_gray_addressing_for_level_filtering (d : Deployment)
    (ranges : List (Addressing.Range SecurityLevel)) (pairs : List IntendedAddressPair) : Prop :=
  d.AddressInventoryCoherent ∧
  (∀ range ∈ ranges, range.low ≤ range.high) ∧
  (∀ address a b, Addressing.Owns ranges address a → Addressing.Owns ranges address b → a = b) ∧
  (∀ pair ∈ pairs, Addressing.Owns ranges pair.source pair.level ∧
    Addressing.Owns ranges pair.destination pair.level) ∧
  (∀ interface ∈ d.interfaces, d.Relevant interface.device → interface.zone = .gray → d.IsLayer interface.device .inner →
    ∃ device ∈ d.devices, device.id = interface.device ∧
      ∃ address, interface.address = some address ∧ Addressing.Owns ranges address device.level) ∧
  ∀ device ∈ d.devices, d.Relevant device.id → device.layer = some .outer ∨ device.kind = .grayFirewall →
    FiltersIntendedPeers d device.id ∧
    ∀ interface ∈ d.interfaces, d.Relevant interface.device → interface.device = device.id → interface.zone = .gray →
      ∀ direction traffic, d.Accepts interface.id direction traffic → InnerEndpoints d traffic →
        IntendedPair pairs traffic.packet</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:23
def msc_gray_addressing_for_level_filtering (d : Deployment)
    (ranges : List (Addressing.Range SecurityLevel)) (pairs : List IntendedAddressPair) : Prop :=
  CoreReq_msc_gray_addressing_for_level_filtering { d with focus := none } ranges pairs</tdn:requirementCode>
    <tdn:requirementStatus>Complete model proof reviewed</tdn:requirementStatus>
    <tdn:requirementTranslation>Gray address ranges must be valid and must assign an address to at most one security level. Inner Gray addresses and intended address pairs belong to the recorded level. Outer components and Gray Firewalls accept Inner-peer traffic only for the intended same-level pairs.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-015">
    <rdfs:label>MACsec encapsulation and standalone encapsulator obligations</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:214
def MACsecEncapsulationCore {S A : Type} (d : Deployment) (model : ForwardingModel S A)
    (uses : List EncapsulationUse) (crossesIP : String → Bool) : Prop :=
  model.CoversDeployment d ∧
  (∀ tunnel ∈ d.tunnels, (d.Relevant tunnel.sender ∨ d.Relevant tunnel.receiver) → tunnel.mechanism = .macsec →
    tunnel.layer = .inner ∨ crossesIP tunnel.id = true →
      ∃ use ∈ uses, use.protectedTunnel = tunnel.id ∧ use.inner = tunnel.sender ∧
        (tunnel.layer = .inner → use.outer.isSome = true) ∧
        (crossesIP tunnel.id = true → use.traversesIP = true)) ∧
  (∀ use ∈ uses, (d.Relevant use.inner ∨ d.Relevant use.encapsulator ∨
      d.Relevant use.remoteEncapsulator) →
    d.authority.aoApprovedEncapsulation use.protocol ∧
    (use.builtInSupported = false → d.standaloneEncapsulator use.encapsulator ∧
      d.OwnedGrayAttachment use.inner use.encapsulator use.inputInterface ∧
      (∀ outer, use.outer = some outer →
        d.OwnedGrayExit use.encapsulator use.outputInterface outer))) ∧
  model.AllTraces (fun events =&gt; ∀ use ∈ uses, (d.Relevant use.inner ∨ d.Relevant use.encapsulator ∨
      d.Relevant use.remoteEncapsulator) → ∀ payload,
    .encrypt payload use.protectedTunnel ∈ events →
      (∀ outer tunnel, use.outer = some outer →
        (∃ t ∈ d.tunnels, t.id = tunnel ∧ t.sender = outer) →
        BeforeEvery events (.encapsulate payload use.encapsulator use.protocol)
          (.encrypt payload tunnel)) ∧
      (use.traversesIP = true → ∀ earlier later layers trafficClass,
        events = earlier ++ [.transmit payload use.outputInterface layers trafficClass] ++ later →
        .encapsulate payload use.encapsulator use.protocol ∈ earlier) ∧
      (∀ first middle last,
        events = first ++ [.encapsulate payload use.encapsulator use.protocol] ++ middle ++
          [.decapsulate payload use.remoteEncapsulator use.protocol] ++ last →
        .decrypt payload use.protectedTunnel ∉ middle))</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:27
def msc_macsec_encapsulation {S A : Type} (context : MscComplianceContext S A) : Prop :=
  MACsecEncapsulationCore { context.deployment with focus := none } context.model
    context.encapsulations context.crossesIP ∧
  ∀ use ∈ context.encapsulations, use.builtInSupported = false →
    context.AllApplicableDuties (.deviceComponent use.encapsulator)</tdn:requirementCode>
    <tdn:requirementStatus>Complete proof unfinished</tdn:requirementStatus>
    <tdn:requirementTranslation>Inner MACsec traffic and MACsec traffic crossing IP must have a declared, approved encapsulation arrangement. Encapsulation precedes the required Outer encryption or IP transmission, and the protected MACsec layer stays encrypted between encapsulation and decapsulation. A standalone encapsulator needs the specified Gray attachments and all applicable component duties.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-016">
    <rdfs:label>Permitted MACsec clear VLAN tags and XPN</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:242
| 16 =&gt; each (fun device record =&gt; device.kind = .macsec →
      (record.optionalClearVLAN = true → "clear-vlan" ∈ record.supportedFeatures) ∧
      (record.optionalXPN = true → "xpn" ∈ record.supportedFeatures))</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>A MACsec device may select clear VLAN tags or XPN only when its recorded supported features contain the corresponding option.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-017">
    <rdfs:label>Mutual authentication and Non-Person Entity certificates</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:444
def MutuallyAuthenticatedTunnels (records : TechnicalDutyRecords) (d : Deployment) : Prop :=
  ∀ tunnel ∈ d.tunnels, (d.Relevant tunnel.sender ∨ d.Relevant tunnel.receiver) →
    ∃ first ∈ records.authentications, ∃ second ∈ records.authentications,
      first.input.verifier = tunnel.sender ∧ first.input.claimant = tunnel.receiver ∧
      second.input.verifier = tunnel.receiver ∧ second.input.claimant = tunnel.sender ∧
      first.association = tunnel.id ∧ second.association = tunnel.id ∧
      match tunnel.mechanism with
      | .ipsec =&gt; AuthenticatedCertificate records first ∧ AuthenticatedCertificate records second
      | .macsec =&gt; AuthenticatedSharedKey records first tunnel.keyContext ∧
          AuthenticatedSharedKey records second tunnel.keyContext</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:245
| 17 =&gt; MutuallyAuthenticatedTunnels records d</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Every relevant tunnel needs authentication observations in both directions, with each verifier authenticating the opposite peer for that tunnel. The current shared condition uses certificate authentication for IPsec and proof of possession of the tunnel key for MACsec.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-018">
    <rdfs:label>CNSS algorithm-policy requirements and choices</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:473
def IPsecAlgorithmConfiguration (record : ComponentDutyRecord) : Prop :=
  record.offeredIPsecSuites ≠ [] ∧
  if record.cnsa2Selected then
    (∀ suite ∈ record.offeredIPsecSuites, CNSA2IPsec suite) ∧
    (∀ connection ∈ record.ipsecConnections,
      connection.initial.keyEstablishment ∈ ["ECDH-P384", "DH3072", "DH4096"] ∧
      connection.intermediate.keyEstablishment = "ML-KEM-1024" ∧
      connection.intermediateEncrypted = true ∧ connection.multipleKeyExchanges = true ∧
      connection.intermediateExchangeSupported = true ∧ connection.ikeFragmentationSupported = true)
  else ∀ suite ∈ record.offeredIPsecSuites, CNSA1IPsec suite</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:246
| 18 =&gt; each (fun device record =&gt;
      (device.kind = .vpn → IPsecAlgorithmConfiguration record) ∧
      (device.kind = .macsec → record.macsecBits = 256 ∧
        record.macsecAlgorithm ∈ ["GCM-AES-256", "GCM-AES-XPN-256"]))</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Every VPN gateway offers a nonempty set of suites satisfying the chosen CNSA profile. Selecting CNSA 2 also requires the recorded classical initial exchange and encrypted ML-KEM-1024 intermediate exchange, with multiple exchanges and IKE fragmentation supported. MACsec components use 256-bit GCM-AES or GCM-AES-XPN.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-019">
    <rdfs:label>IPsec CNSA profile and post-quantum exchange sequence</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:473
def IPsecAlgorithmConfiguration (record : ComponentDutyRecord) : Prop :=
  record.offeredIPsecSuites ≠ [] ∧
  if record.cnsa2Selected then
    (∀ suite ∈ record.offeredIPsecSuites, CNSA2IPsec suite) ∧
    (∀ connection ∈ record.ipsecConnections,
      connection.initial.keyEstablishment ∈ ["ECDH-P384", "DH3072", "DH4096"] ∧
      connection.intermediate.keyEstablishment = "ML-KEM-1024" ∧
      connection.intermediateEncrypted = true ∧ connection.multipleKeyExchanges = true ∧
      connection.intermediateExchangeSupported = true ∧ connection.ikeFragmentationSupported = true)
  else ∀ suite ∈ record.offeredIPsecSuites, CNSA1IPsec suite</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:250
| 19 =&gt; each (fun device record =&gt; device.kind = .vpn → IPsecAlgorithmConfiguration record)</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Every VPN gateway offers at least one suite, and every offered suite meets its selected CNSA profile. CNSA 2 connections begin with ECDH-P384, DH3072, or DH4096 and use ML-KEM-1024 in an encrypted intermediate exchange. Multiple exchanges, the intermediate exchange, and IKE fragmentation must be supported.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-020">
    <rdfs:label>VPN certificate loading and authentication checks</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:423
def CertificateIdentityConfiguration (records : TechnicalDutyRecords) (component : String)
    (removeDefaults : Bool) : Prop :=
  (∃ certificate ∈ records.certificates,
    certificate.subject = component ∧ certificate.nonPersonEntity = true ∧
    certificate.id ≠ "" ∧ certificate.trustAnchor ∈ certificate.chain ∧
    certificate.issuer ∈ certificate.chain) ∧
  (∀ first ∈ records.certificates, ∀ second ∈ records.certificates,
    first.subject = component → first.id = second.id → second.subject = component) ∧
  (∀ observation ∈ records.authentications, (observation.input.verifier = component ∨ observation.input.claimant = component) →
    AuthenticatedCertificate records observation) ∧
  (removeDefaults = true → ∀ certificate ∈ records.certificates,
    certificate.subject = component →
    certificate.vendorDefault = false ∧ certificate.selfSigned = false ∧
      certificate.proprietary = false)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:251
| 20 =&gt; each (fun device record =&gt; device.kind = .vpn →
      CertificateIdentityConfiguration records device.id record.removeDefaultCertificatesSelected)</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Every VPN gateway has a nonempty device-certificate identity whose chain contains its issuer and trust anchor. That certificate identity cannot belong to another component. Recorded authentications involving the gateway satisfy the certificate-verification conditions. Selecting default-certificate removal excludes vendor-default, self-signed, and proprietary certificates.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-021">
    <rdfs:label>VPN private-key access confinement</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:257
def CoreReq_msc_vpn_private_key_confinement {S A : Type} (d : Deployment) (model : ForwardingModel S A)
    (keys : List PrivateKey) (objectiveSelected : String → Bool)
    (policies : List MandatoryKeyPolicy) : Prop :=
  StoredVPNKeyInventory d keys ∧
  (model.AllTraces (fun events =&gt; ∀ key ∈ keys, d.Relevant key.gateway → ∀ interface,
    .privateKeyExport key.gateway key.id interface ∉ events)) ∧
  (∀ key ∈ keys, d.Relevant key.gateway → objectiveSelected key.gateway = true → ∃ policy ∈ policies,
    policy.gateway = key.gateway ∧ policy.enforced = true ∧
    ∀ principal, policy.permits principal key.id → principal = key.gateway) ∧
  model.AllTraces (fun events =&gt; ∀ key ∈ keys, d.Relevant key.gateway → objectiveSelected key.gateway = true →
    ∀ principal, .privateKeyRead key.gateway key.id principal ∈ events → principal = key.gateway)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:33
def msc_vpn_private_key_confinement {S A : Type} (d : Deployment) (model : ForwardingModel S A)
    (keys : List PrivateKey) (objectiveSelected : String → Bool)
    (policies : List MandatoryKeyPolicy) : Prop :=
  CoreReq_msc_vpn_private_key_confinement { d with focus := none } model keys objectiveSelected policies</tdn:requirementCode>
    <tdn:requirementStatus>Complete model proof reviewed</tdn:requirementStatus>
    <tdn:requirementTranslation>The key inventory must account for the VPN gateway's stored private keys. No modeled trace may export a listed private key. When the access-control objective is selected, an enforced policy permits only the gateway to read its key, and every modeled key read respects that restriction.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-022">
    <rdfs:label>IKEv2 and IKE/ESP encryption-mode alternatives</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:484
def IPsecModesAndLifetimes (record : ComponentDutyRecord) : Prop :=
  record.ikeVersion = 2 ∧
  record.ikeMode = (if record.ikeGCMSelected then "GCM" else "CBC") ∧
  record.espMode = (if record.espGCMSelected then "GCM" else "CBC") ∧
  (record.espMode = "CBC" → record.espHMAC = true) ∧
  0 &lt; record.ikeLifetimeSeconds ∧ record.ikeLifetimeSeconds ≤ 86400 ∧
  0 &lt; record.espLifetimeSeconds ∧ record.espLifetimeSeconds ≤ 28800</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:253
| 22 =&gt; each (fun device record =&gt; device.kind = .vpn → IPsecModesAndLifetimes record)</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Every VPN gateway uses IKEv2 and the selected GCM or CBC modes. CBC for ESP requires HMAC. Recorded IKE lifetimes are positive and at most 24 hours; ESP lifetimes are positive and at most eight hours.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-023">
    <rdfs:label>VPN SA lifetimes and reauthentication</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:484
def IPsecModesAndLifetimes (record : ComponentDutyRecord) : Prop :=
  record.ikeVersion = 2 ∧
  record.ikeMode = (if record.ikeGCMSelected then "GCM" else "CBC") ∧
  record.espMode = (if record.espGCMSelected then "GCM" else "CBC") ∧
  (record.espMode = "CBC" → record.espHMAC = true) ∧
  0 &lt; record.ikeLifetimeSeconds ∧ record.ikeLifetimeSeconds ≤ 86400 ∧
  0 &lt; record.espLifetimeSeconds ∧ record.espLifetimeSeconds ≤ 28800</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:254
| 23 =&gt; each (fun device record =&gt; device.kind = .vpn →
      IPsecModesAndLifetimes record ∧
      ∀ rekey ∈ records.rekeys, rekey.device = device.id →
        rekey.authenticatedAt &lt; rekey.rekeyedAt ∧
        ∃ observation ∈ records.authentications,
          observation.input.verifier = device.id ∧ observation.input.claimant = rekey.peer ∧
          observation.association = rekey.association ∧
          observation.input.time = rekey.authenticatedAt ∧ AuthenticatedCertificate records observation)</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>VPN gateways satisfy the IKEv2, selected-mode, and positive lifetime limits: at most 24 hours for IKE and eight hours for ESP. Every recorded rekey follows an authenticated observation for the same gateway, peer, and association; the authentication time precedes the rekey time.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-024">
    <rdfs:label>MACsec authentication alternatives and AS scope</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:537
def CoreReq_msc_macsec_authentication_choice_and_as {S A : Type} (d : Deployment)
    (model : ForwardingModel S A) (primitive : TLSPrimitive)
    (authentication : List MACsecAuthentication) : Prop :=
  MACsecInstalledHistory d model primitive authentication ∧
  (∀ device ∈ d.devices, d.Relevant device.id → device.kind = .macsec →
    ∃ selected ∈ authentication, selected.device = device.id) ∧
  (∀ selected ∈ authentication, (d.Relevant selected.device ∨ d.Relevant selected.server) →
    d.IsDevice selected.device .macsec ∧ d.IsDevice selected.peer .macsec ∧
    (selected.method = .preSharedCAK ↔ d.preSharedCAKAuthenticated selected.device = true) ∧
    (selected.method = .eapTLS ↔ d.certificateAuthenticated selected.device = true) ∧
    (selected.keyServer = selected.device ∨ selected.keyServer = selected.peer) ∧
    selected.secureAssociationKey ≠ "" ∧
    match selected.method with
    | .preSharedCAK =&gt; selected.cak ≠ "" ∧ selected.cak = selected.peerCAK
    | .eapTLS =&gt; d.IsDevice selected.server .authenticationServer ∧
        selected.supportedRoles = [.supplicant, .authenticator] ∧
        selected.deviceCertificate ≠ "" ∧ selected.peerCertificate ≠ "" ∧
        selected.serverCertificate ≠ "" ∧
        EAPEndpointRoleEvidence primitive selected ∧
        (∃ exchange ∈ selected.exchanges, EAPSessionBinding primitive selected exchange) ∧
        (∀ site zone, (site, zone) ∈ selected.serverAttachments ↔
          d.networkAttachment selected.server site zone) ∧
        (∃ site zone, selected.serverAttachments ≠ [] ∧
          ∀ attachment ∈ selected.serverAttachments, attachment = (site, zone)) ∧
        ∀ attachment ∈ selected.serverAttachments, attachment.2 = .red ∨ attachment.2 = .gray) ∧
  model.AllTraces (fun events =&gt; ∀ earlier later payload tunnel,
    events = earlier ++ [.encrypt payload tunnel] ++ later →
    ∀ configured ∈ d.tunnels, configured.id = tunnel → configured.mechanism = .macsec →
    ∃ selected ∈ authentication, selected.device = configured.sender ∧
      selected.peer = configured.receiver ∧
      MACsecKeyUsePrefix primitive selected payload tunnel earlier)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:38
def msc_macsec_authentication_choice_and_as {S A : Type} (d : Deployment)
    (model : ForwardingModel S A) (primitive : TLSPrimitive)
    (authentication : List MACsecAuthentication) : Prop :=
  CoreReq_msc_macsec_authentication_choice_and_as { d with focus := none } model primitive authentication</tdn:requirementCode>
    <tdn:requirementStatus>Complete proof unfinished</tdn:requirementStatus>
    <tdn:requirementTranslation>Each MACsec device must have a declared authentication choice and peer. A pre-shared CAK must match the peer's CAK. EAP-TLS requires the device, peer, and server certificates, the supported endpoint roles, session evidence, and an Authentication Server attached to one Red or Gray site-and-zone pair. Installed keys and every encryption use must be connected to the required earlier authentication and key setup.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-025">
    <rdfs:label>MACsec encryption and key wrapping algorithms</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:262
| 25 =&gt; each (fun device record =&gt; device.kind = .macsec →
      record.keyWrapAlgorithm = "AES-Key-Wrap" ∧ record.keyWrapBits = 256 ∧
      record.macsecBits = 256 ∧ record.macsecAlgorithm ∈ ["GCM-AES-256", "GCM-AES-XPN-256"])</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>MACsec encryption uses 256-bit GCM-AES or GCM-AES-XPN, and key wrapping uses 256-bit AES-Key-Wrap.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-026">
    <rdfs:label>MACsec EAP-TLS CNSA profile alternatives</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:492
def EAPAlgorithmConfiguration (record : ComponentDutyRecord) : Prop :=
  record.offeredEAPSuites ≠ [] ∧
  if record.eapCNSA2Selected then record.eapTLSVersionMajor = 1 ∧
    record.eapTLSVersionMinor = 3 ∧
    ∀ suite ∈ record.offeredEAPSuites, CNSA2EAP suite
  else ∀ suite ∈ record.offeredEAPSuites, CNSA1EAP suite</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:265
| 26 =&gt; each (fun device record =&gt;
      (device.kind = .macsec ∧ d.certificateAuthenticated device.id = true ∨
        device.kind = .authenticationServer) → EAPAlgorithmConfiguration record)</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Certificate-authenticated MACsec devices and Authentication Servers offer a nonempty set of EAP-TLS suites, all satisfying the selected CNSA profile. Selecting CNSA 2 requires TLS 1.3.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-027">
    <rdfs:label>MACsec key generation, key-server selection, and rollover</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:596
def CoreReq_msc_macsec_key_generation_and_server (d : Deployment) (keys : List MACsecKey)
    (pairs : List MACsecServerPair) (provisioning : List KeyProvisioning)
    (eapCAKGeneratedByApprovedKGS : String → String → Prop) : Prop :=
  (∀ key ∈ keys, d.RelevantKey key.cak → 16 ≤ key.ckn.length ∧ d.authority.nsaApprovedGenerator key.cknGenerator ∧
    (match key.cakOrigin with
      | .generated generator =&gt; d.authority.nsaApprovedGenerator generator ∧
          ∃ provision ∈ provisioning, provision.key = key.cak ∧ provision.generator = generator ∧
            d.authority.securityAdministrator provision.administrator ∧
            ∀ tunnel ∈ d.tunnels, (d.Relevant tunnel.sender ∨ d.Relevant tunnel.receiver) → tunnel.mechanism = .macsec → tunnel.keyContext = key.cak →
              (∃ applied ∈ provision.applications, applied.1 = tunnel.sender ∧
                provision.obtainedOrder &lt; applied.2) ∧
              ∃ applied ∈ provision.applications, applied.1 = tunnel.receiver ∧
                provision.obtainedOrder &lt; applied.2
      | .eapDerived msk =&gt; msk ≠ "" ∧ ∃ generator, d.authority.nsaApprovedGenerator generator ∧
          eapCAKGeneratedByApprovedKGS key.cak generator) ∧ key.fallbackEnabled = false) ∧
  (∀ tunnel ∈ d.tunnels, (d.Relevant tunnel.sender ∨ d.Relevant tunnel.receiver) → tunnel.mechanism = .macsec →
    (∃ key ∈ keys, key.cak = tunnel.keyContext) ∧
    ∃ pair ∈ pairs, pair.first = tunnel.sender ∧ pair.second = tunnel.receiver) ∧
  ∀ pair ∈ pairs, (d.Relevant pair.first ∨ d.Relevant pair.second) → pair.centralSite = d.centralManagementSite ∧ pair.first ≠ pair.second ∧
    ((pair.firstValue = 0 ∧ pair.secondValue = 1) ∨
      (pair.firstValue = 1 ∧ pair.secondValue = 0)) ∧
    ∀ site, pair.centralSite = some site →
      (∃ first ∈ d.devices, first.id = pair.first ∧ first.site = site ∧ pair.firstValue = 0) ∨
      (∃ second ∈ d.devices, second.id = pair.second ∧ second.site = site ∧ pair.secondValue = 0)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:43
def msc_macsec_key_generation_and_server (d : Deployment) (keys : List MACsecKey)
    (pairs : List MACsecServerPair) (provisioning : List KeyProvisioning)
    (eapCAKGeneratedByApprovedKGS : String → String → Prop) : Prop :=
  CoreReq_msc_macsec_key_generation_and_server { d with focus := none } keys pairs provisioning
    eapCAKGeneratedByApprovedKGS</tdn:requirementCode>
    <tdn:requirementStatus>Complete model proof reviewed</tdn:requirementStatus>
    <tdn:requirementTranslation>Relevant MACsec keys use the required key-name length and approved generation records, with fallback disabled. Generated CAKs must be obtained by an authorized administrator before application to both peers; EAP-derived CAKs need the required generator evidence. Every MACsec tunnel has a key and peer-pair record. The peers have complementary key-server values, and a centrally managed pair gives value 0 to a peer at the central site.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-028">
    <rdfs:label>MACsec mandatory protection parameters</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:632
def CoreReq_msc_macsec_protection_parameters {S A : Type} (d : Deployment)
    (model : ForwardingModel S A) (parameters : List MACsecParameters) : Prop :=
  model.CoversDeployment d ∧
  (∀ device ∈ d.devices, d.Relevant device.id → device.kind = .macsec →
    ∃ parameter ∈ parameters, parameter.device = device.id) ∧
  (∀ parameter ∈ parameters, d.Relevant parameter.device → parameter.dataDelayProtection = true ∧
    parameter.lifetimeMilliseconds = 6000 ∧ parameter.normalHelloMilliseconds = 2000 ∧
    0 &lt; parameter.activeHelloMilliseconds ∧ parameter.activeHelloMilliseconds ≤ 2000 ∧
    (parameter.replayWindow = 2 ∨ (parameter.feasibleReplayWindow parameter.replayWindow ∧
      ∀ feasible, parameter.feasibleReplayWindow feasible → parameter.replayWindow ≤ feasible)) ∧
    parameter.confidentialityOffset = 0 ∧ parameter.mustSecure = true) ∧
  model.AllTraces (fun events =&gt; ∀ payload iface layers trafficClass,
    .transmit payload iface layers trafficClass ∈ events → ¬ model.GenuineControl payload →
    ∀ interface ∈ d.interfaces, d.Relevant interface.device → interface.id = iface →
    ∀ device ∈ d.devices, d.Relevant device.id → device.id = interface.device → device.kind = .macsec →
    device.layer = some .inner ∧ interface.zone = .gray ∨
      device.layer = some .outer ∧ interface.zone = .black →
    ∃ tunnel ∈ d.tunnels, tunnel.mechanism = .macsec ∧ tunnel.sender = device.id ∧ tunnel.id ∈ layers)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:49
def msc_macsec_protection_parameters {S A : Type} (d : Deployment)
    (model : ForwardingModel S A) (parameters : List MACsecParameters) : Prop :=
  CoreReq_msc_macsec_protection_parameters { d with focus := none } model parameters</tdn:requirementCode>
    <tdn:requirementStatus>Complete proof unfinished</tdn:requirementStatus>
    <tdn:requirementTranslation>Every MACsec device has parameters with data-delay protection, a 6000 ms lifetime, a 2000 ms normal hello interval, and a positive active hello interval no greater than 2000 ms. The replay window is 2 or the smallest feasible value; confidentiality offset is 0 and must-secure is enabled. Every relevant non-control transmission carries that device's MACsec tunnel layer.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-029">
    <rdfs:label>Inner encryption and decryption cannot be bypassed</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:659
def TraceNoBypass (d : Deployment) (genuineControl : PayloadId → Prop)
    (layer : Layer) (events : List NetworkEvent) : Prop :=
  (∀ earlier middle later payload ingress receivedLayers receiveClass egress sentLayers sendClass,
    events = earlier ++ [.receive payload ingress receivedLayers receiveClass] ++ middle ++
      [.transmit payload egress sentLayers sendClass] ++ later →
    ¬ genuineControl payload →
    ∀ input ∈ d.interfaces, ∀ output ∈ d.interfaces,
      input.id = ingress → output.id = egress → input.device = output.device →
      d.IsLayer input.device layer →
      (input.zone = InternalZone layer → output.zone ≠ InternalZone layer →
        ∃ tunnel ∈ d.tunnels, tunnel.layer = layer ∧ tunnel.sender = input.device ∧
          tunnel.id ∈ sentLayers ∧ .encrypt payload tunnel.id ∈ middle) ∧
      (input.zone = ExternalZone layer → output.zone = InternalZone layer →
        ∃ tunnel ∈ d.tunnels, tunnel.layer = layer ∧ tunnel.receiver = input.device ∧
          tunnel.id ∈ receivedLayers ∧ .decrypt payload tunnel.id ∈ middle)) ∧
  ∀ earlier later payload iface layers trafficClass,
    events = earlier ++ [.transmit payload iface layers trafficClass] ++ later →
    ¬ genuineControl payload →
    ∀ interface ∈ d.interfaces, interface.id = iface →
      d.IsLayer interface.device layer → interface.zone = ExternalZone layer →
      ∃ tunnel ∈ d.tunnels, tunnel.layer = layer ∧ tunnel.sender = interface.device ∧
        tunnel.id ∈ layers ∧ .encrypt payload tunnel.id ∈ earlier</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:693
def CoreReq_msc_inner_tunnel_no_bypass {S A : Type} (d : Deployment) (model : ForwardingModel S A)
    (components : List EncryptionComponentConfiguration)
    (outboundMACObjective inboundMACObjective : Bool) : Prop :=
  ComponentConfigurationCoverage d .inner components ∧ LayerNoBypass d model .inner ∧
  ∀ component ∈ components, d.Relevant component.id →
    (component.mechanism = .ipsec → component.espTunnelMode = true ∧ component.associatedIPTunnel = true) ∧
    (outboundMACObjective = true → component.outboundMACPolicy = true) ∧
    (inboundMACObjective = true → component.inboundMACPolicy = true)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:53
def msc_inner_tunnel_no_bypass {S A : Type} (d : Deployment) (model : ForwardingModel S A)
    (components : List EncryptionComponentConfiguration)
    (outboundMACObjective inboundMACObjective : Bool) : Prop :=
  CoreReq_msc_inner_tunnel_no_bypass { d with focus := none } model components
    outboundMACObjective inboundMACObjective</tdn:requirementCode>
    <tdn:requirementStatus>Complete proof unfinished</tdn:requirementStatus>
    <tdn:requirementTranslation>The records cover every Inner encryptor and match its mechanism. For every modeled non-control packet crossing from the internal side, Inner encryption occurs before transmission and the transmitted packet carries the Inner layer. Incoming protected traffic is decrypted before passage to the internal side. IPsec uses ESP tunnel mode and an associated IP tunnel. Selected mandatory-access-control objectives must be enabled.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-030">
    <rdfs:label>Outer encryption and decryption cannot be bypassed</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:659
def TraceNoBypass (d : Deployment) (genuineControl : PayloadId → Prop)
    (layer : Layer) (events : List NetworkEvent) : Prop :=
  (∀ earlier middle later payload ingress receivedLayers receiveClass egress sentLayers sendClass,
    events = earlier ++ [.receive payload ingress receivedLayers receiveClass] ++ middle ++
      [.transmit payload egress sentLayers sendClass] ++ later →
    ¬ genuineControl payload →
    ∀ input ∈ d.interfaces, ∀ output ∈ d.interfaces,
      input.id = ingress → output.id = egress → input.device = output.device →
      d.IsLayer input.device layer →
      (input.zone = InternalZone layer → output.zone ≠ InternalZone layer →
        ∃ tunnel ∈ d.tunnels, tunnel.layer = layer ∧ tunnel.sender = input.device ∧
          tunnel.id ∈ sentLayers ∧ .encrypt payload tunnel.id ∈ middle) ∧
      (input.zone = ExternalZone layer → output.zone = InternalZone layer →
        ∃ tunnel ∈ d.tunnels, tunnel.layer = layer ∧ tunnel.receiver = input.device ∧
          tunnel.id ∈ receivedLayers ∧ .decrypt payload tunnel.id ∈ middle)) ∧
  ∀ earlier later payload iface layers trafficClass,
    events = earlier ++ [.transmit payload iface layers trafficClass] ++ later →
    ¬ genuineControl payload →
    ∀ interface ∈ d.interfaces, interface.id = iface →
      d.IsLayer interface.device layer → interface.zone = ExternalZone layer →
      ∃ tunnel ∈ d.tunnels, tunnel.layer = layer ∧ tunnel.sender = interface.device ∧
        tunnel.id ∈ layers ∧ .encrypt payload tunnel.id ∈ earlier</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:702
def CoreReq_msc_outer_tunnel_no_bypass {S A : Type} (d : Deployment) (model : ForwardingModel S A)
    (components : List EncryptionComponentConfiguration)
    (outboundMACObjective inboundMACObjective : Bool) : Prop :=
  ComponentConfigurationCoverage d .outer components ∧ LayerNoBypass d model .outer ∧
  (∀ component ∈ components, d.Relevant component.id →
    (component.mechanism = .ipsec → component.espTunnelMode = true) ∧
    (outboundMACObjective = true → component.outboundMACPolicy = true) ∧
    (inboundMACObjective = true → component.inboundMACPolicy = true)) ∧
  model.AllTraces (fun events =&gt; ∀ payload ingress layers trafficClass,
    .receive payload ingress layers trafficClass ∈ events → ¬ model.GenuineControl payload →
    ∀ interface ∈ d.interfaces, d.Relevant interface.device → interface.id = ingress → interface.zone = .gray →
      d.IsLayer interface.device .outer →
      ∃ tunnel ∈ d.tunnels, tunnel.layer = .inner ∧ layers = [tunnel.id])</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:59
def msc_outer_tunnel_no_bypass {S A : Type} (d : Deployment) (model : ForwardingModel S A)
    (components : List EncryptionComponentConfiguration)
    (outboundMACObjective inboundMACObjective : Bool) : Prop :=
  CoreReq_msc_outer_tunnel_no_bypass { d with focus := none } model components
    outboundMACObjective inboundMACObjective</tdn:requirementCode>
    <tdn:requirementStatus>Complete proof unfinished</tdn:requirementStatus>
    <tdn:requirementTranslation>The records cover every Outer encryptor and match its mechanism. Every modeled non-control outward transmission carries the Outer layer after Outer encryption, and an inward crossing requires Outer decryption. IPsec uses ESP tunnel mode, and selected mandatory-access-control objectives are enabled. Non-control traffic arriving at an Outer Gray interface already carries exactly one Inner tunnel layer.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-031">
    <rdfs:label>Routing and switching limits on Encryption Components</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:268
| 31 =&gt; ∀ use ∈ records.routing, subject.Contains use.component →
      (d.IsLayer use.component .outer → use.dynamicProtocol = false) ∧
      (d.IsLayer use.component .inner → use.ownTunnelLookup = true ∨
        (use.sourceComponent = use.component ∧ use.destinationComponent = use.component))</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Outer encryptors must not use a dynamic routing protocol. An Inner routing use must serve its own tunnel lookup or have that same component as both source and destination.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-032">
    <rdfs:label>TRANSEC under the stated deployment conditions</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:716
def CoreReq_msc_transec_conditions (installations : List CoverInstallation) : Prop :=
  TDN.Requirements.msc_transec_conditions (installations.map CoverInstallation.use) ∧
  (∀ installation ∈ installations, installation.use.enabled = installation.active) ∧
  ∀ installation ∈ installations,
    installation.use.publicInternet = true ∨
      (installation.use.objectiveSelected = true ∧ installation.use.externalMACsec = true ∧
        installation.use.outerFirewallAttached = true) →
    installation.active = true ∧ ScheduledCoverGuarantee installation.sender</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:65
def msc_transec_conditions := CoreReq_msc_transec_conditions</tdn:requirementCode>
    <tdn:requirementStatus>Complete model proof reviewed</tdn:requirementStatus>
    <tdn:requirementTranslation>The TRANSEC records must satisfy the selected conditions and agree with actual modeled activation. Public-Internet use, or the selected external-MACsec objective with an Outer Firewall, requires an active installation and its ScheduledCoverGuarantee.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-033">
    <rdfs:label>Packet sizing to control fragmentation</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:765
def CoreReq_msc_packet_size_configuration (interfaces : List PacketSizing)
    (profiles : List FragmentationProfile) : Prop :=
  ∀ sizing ∈ interfaces,
    (sizing.role ≠ .other →
      0 &lt; sizing.externalMtu ∧ 0 &lt; sizing.payloadLimit ∧
      (sizing.family = .ipv6 → sizing.ipv6PmtuConfigured = true) ∧
      ∀ bytes, bytes ≤ sizing.payloadLimit → sizing.encodedSize bytes ≤ sizing.externalMtu) ∧
    (sizing.role = .innerExternal → sizing.innerObjectiveSelected = true →
      0 &lt; sizing.externalMtu ∧
      (sizing.family = .ipv6 → sizing.ipv6PmtuConfigured = true) ∧
      ∃ profile ∈ profiles, profile.interface = sizing.interface ∧
        profile.afterMtu = sizing.externalMtu ∧
        (∀ bytes, 0 &lt; bytes → bytes ≤ sizing.payloadLimit →
          bytes ∈ profile.supportedPayloadSizes ∧
          sizing.encodedSize bytes = bytes + profile.afterOverhead) ∧
        profile.Reduces)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:67
def msc_packet_size_configuration {S A : Type} (d : Deployment) (model : ForwardingModel S A)
    (sizes : WireSizeModel S) (sizing : List PacketSizing) (profiles : List FragmentationProfile) : Prop :=
  model.CoversDeployment { d with focus := none } ∧ sizes.Correspondence model sizing ∧ sizes.NoFurtherFragmentation model sizing ∧
  PacketSizingInventory { d with focus := none } model sizing ∧
  CoreReq_msc_packet_size_configuration sizing profiles</tdn:requirementCode>
    <tdn:requirementStatus>Complete model proof reviewed</tdn:requirementStatus>
    <tdn:requirementTranslation>The model must cover the deployment and its packet-sizing inventory. The byte-size model must agree with packet processing and show that the selected sizing avoids further fragmentation. The recorded before-and-after fragmentation profiles must also satisfy the sizing conditions.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-034">
    <rdfs:label>Outer Firewall placement for untrusted Black transport</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:878
def CoreReq_msc_outer_firewall_placement {Node : Type}
    (untrustedBlack publicInternet grayFirewallRequired : Bool)
    (edge grayConnection : Node → Node → Prop)
    (outer firewall black grayFirewall inner : Node → Prop)
    (insideAttachment outsideAttachment externalBlackConnection : Node → Node → Prop) : Prop :=
  TDN.Requirements.msc_outer_firewall_placement untrustedBlack publicInternet grayFirewallRequired
    edge grayConnection outer firewall black grayFirewall inner
    insideAttachment outsideAttachment externalBlackConnection</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:73
def msc_outer_firewall_placement := @CoreReq_msc_outer_firewall_placement</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MscFirewallWaypointingTheorems.lean:5
def msc_outer_firewall_placement {Node : Type}
    (untrustedBlack publicInternet grayFirewallRequired : Bool)
    (edge grayConnection : Node → Node → Prop)
    (outer firewall black grayFirewall inner : Node → Prop)
    (insideAttachment outsideAttachment externalBlackConnection : Node → Node → Prop) : Prop :=
  (publicInternet = true → untrustedBlack = true) ∧
  (∀ a b, insideAttachment a b ∨ outsideAttachment a b ∨ externalBlackConnection a b →
    Relation.ReflTransGen edge a b) ∧
  (if publicInternet then
    ∀ o, outer o → ∃ f b, firewall f ∧ black b ∧
      insideAttachment o f ∧ outsideAttachment f b
   else ∀ o, outer o → ∃ b, black b ∧ externalBlackConnection o b) ∧
  (untrustedBlack = true → ∀ o b, outer o → black b →
    ¬ Relation.ReflTransGen (Waypointing.Avoiding edge firewall) o b) ∧
  (if grayFirewallRequired then
    ∀ o, outer o → ∃ g, grayFirewall g ∧ grayConnection o g
   else ∀ o, outer o → ∃ i, inner i ∧ grayConnection o i)</tdn:requirementCode>
    <tdn:requirementStatus>Complete model proof reviewed</tdn:requirementStatus>
    <tdn:requirementTranslation>Public Internet counts as untrusted Black transport. Declared attachments must correspond to paths. Internet-connected Outer devices attach through Outer Firewalls; other Outer devices have the specified Black connection. Every Outer-to-untrusted-Black path crosses an Outer Firewall. Each Outer also has the required internal Gray connection to a Gray Firewall or Inner component.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-035">
    <rdfs:label>Permitted protocols and peers at encryption and firewall boundaries</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:898
def CoreReq_msc_boundary_interface_filtering (d : Deployment) (outerFirewallRequired : Bool)
    (firewallInternal : String → Bool) (localOuter : String → String) : Prop :=
  d.AddressInventoryCoherent ∧ d.ProcessingCoherent ∧ d.UDPBindingsCoherent ∧
  ∀ interface ∈ d.interfaces, d.Relevant interface.device → ∀ device ∈ d.devices, d.Relevant device.id → interface.device = device.id →
    ((device.layer = some .outer ∧ interface.zone = .black) ∨
      (device.layer = some .inner ∧ interface.zone = .gray) ∨
      (device.layer = some .inner ∧ interface.zone = .red) ∨
      (device.kind = .outerFirewall ∧ outerFirewallRequired = true)) →
    d.BoundaryPolicyCoverage interface ∧ ∀ direction traffic, d.BoundaryAdmission device interface direction traffic →
      (device.layer = some .outer → interface.zone = .black →
        ((device.kind = .vpn → d.IPsecTraffic traffic ∨
          ApprovedControl d device.id traffic) ∧
        (device.kind = .macsec → PacketMACsec traffic.packet ∨
          ApprovedControl d device.id traffic) ∧
        (direction = .outbound → d.IntendedPacketPeerAt interface.id device.id traffic))) ∧
      (device.layer = some .inner → interface.zone = .gray →
        d.PermittedTunnelTraffic traffic ∨ AOApprovedControl d device.id traffic) ∧
      (device.layer = some .inner → interface.zone = .red →
        d.redService device.id traffic.packet.source (TransportServicePort traffic.packet true) ∨
        d.redService device.id traffic.packet.destination (TransportServicePort traffic.packet false)) ∧
      (device.kind = .outerFirewall → outerFirewallRequired = true →
        (d.PermittedTunnelTraffic traffic ∨ ApprovedControl d device.id traffic) ∧
        (direction = .inbound → ¬ ApprovedControl d device.id traffic →
          if firewallInternal interface.id then
            LocalOuterAddress d device.id (localOuter device.id) traffic.packet.source
          else LocalOuterAddress d device.id (localOuter device.id) traffic.packet.destination))</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:75
def msc_boundary_interface_filtering (d : Deployment) (outerFirewallRequired : Bool)
    (firewallInternal : String → Bool) (localOuter : String → String) : Prop :=
  CoreReq_msc_boundary_interface_filtering { d with focus := none } outerFirewallRequired
    firewallInternal localOuter</tdn:requirementCode>
    <tdn:requirementStatus>Complete model proof reviewed</tdn:requirementStatus>
    <tdn:requirementTranslation>Addresses, packet processing, UDP bindings, and interface policies must agree. Admitted traffic at the specified Inner, Outer, and Outer-Firewall boundaries must match the permitted tunnel, service, or approved-control conditions. Outbound Outer traffic must use an intended peer, and Outer-Firewall ingress must use the local Outer address on the appropriate side.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-036">
    <rdfs:label>Minimal network-interface exposure</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:272
| 36 =&gt; each (fun _ record =&gt; record.enabledInterfaces = record.minimumFeasibleExposure ∧
      ∀ interface ∈ record.unusedInterfaces, interface ∉ record.enabledInterfaces)</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Each component's enabled interfaces must equal its recorded minimum feasible exposure, and every recorded unused interface must be disabled.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-037">
    <rdfs:label>Outer-component third-party contact restrictions</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:932
def CoreReq_msc_outer_third_party_services (d : Deployment) (objectiveSelected : String → Bool)
    (features : List ThirdPartyFeature) : Prop :=
  ∀ feature ∈ features, d.Relevant feature.device → d.IsLayer feature.device .outer → feature.canContactThirdParty = true →
    if objectiveSelected feature.device then feature.enabled = false else
      ∀ interface ∈ d.interfaces, d.Relevant interface.device → interface.device = feature.device →
        ∀ traffic, feature.emittedTraffic traffic →
          ¬ d.Accepts interface.id .outbound traffic</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:80
def msc_outer_third_party_services (d : Deployment) (objectiveSelected : String → Bool)
    (features : List ThirdPartyFeature) : Prop :=
  CoreReq_msc_outer_third_party_services { d with focus := none } objectiveSelected features</tdn:requirementCode>
    <tdn:requirementStatus>Complete model proof reviewed</tdn:requirementStatus>
    <tdn:requirementTranslation>An Outer feature that can contact third parties must be disabled when the disabling objective is selected. Otherwise, every packet that feature could emit must be rejected on every relevant outbound interface.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-038">
    <rdfs:label>IP header and multicast filtering</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:957
def CoreReq_msc_ip_header_and_multicast_filtering (d : Deployment)
    (dropIPv4OptionsObjective : String → Bool) : Prop :=
  (∀ device, dropIPv4OptionsObjective device = d.dropIPv4Options device) ∧
  d.AddressInventoryCoherent ∧ d.ProcessingCoherent ∧ d.LinkPoliciesComplete ∧
  ∀ interface ∈ d.interfaces, d.Relevant interface.device → ∀ device ∈ d.devices, d.Relevant device.id → interface.device = device.id →
    HeaderFilterApplies device interface →
    d.PolicyCoverage interface ∧
    ∀ traffic, d.Accepts interface.id .inbound traffic →
      (device.layer = some .outer → interface.zone = .black →
        traffic.multicast = false ∨ NecessaryApprovedL2Control d interface traffic) ∧
      (device.kind = .vpn → traffic.ipVersion = some 4 → traffic.ipProtocol ∈ [6, 17, 50, 1]) ∧
      (device.kind = .vpn → traffic.ipVersion = some 6 →
        traffic.packet.ipv6NextHeader ∈ [50, 6, 17, 58]) ∧
      (device.kind = .vpn → device.layer = some .outer → traffic.ipVersion = some 4 →
        dropIPv4OptionsObjective device.id = true → traffic.packet.ipv4HeaderWords = 5)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:84
def msc_ip_header_and_multicast_filtering (d : Deployment)
    (dropIPv4OptionsObjective : String → Bool) : Prop :=
  CoreReq_msc_ip_header_and_multicast_filtering { d with focus := none } dropIPv4OptionsObjective</tdn:requirementCode>
    <tdn:requirementStatus>Complete model proof reviewed</tdn:requirementStatus>
    <tdn:requirementTranslation>The interface policy must cover the relevant VPN and Outer interfaces. Accepted VPN traffic uses the listed IPv4 protocols or IPv6 next headers. Outer Black multicast is rejected except for the precisely modeled necessary, approved Layer-2 control traffic. When the IPv4-options objective is selected, accepted Outer VPN IPv4 packets have the ordinary five-word header.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-039">
    <rdfs:label>Outer Gray-interface allowlist and default denial</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:1004
def CoreReq_msc_outer_gray_interface_policy (d : Deployment) (cdpOnGray : Bool) : Prop :=
  d.AddressInventoryCoherent ∧ d.ProcessingCoherent ∧ d.UDPBindingsCoherent ∧
  ∀ interface ∈ d.interfaces, d.Relevant interface.device → d.IsLayer interface.device .outer → interface.zone = .gray →
    d.PolicyCoverage interface ∧
    (∀ direction traffic, d.Accepts interface.id direction traffic →
      OuterGrayRestrictions d interface direction cdpOnGray traffic ∧
      OuterPolicyAllowance d interface.device cdpOnGray traffic) ∧
    ∀ direction hook traffic, d.PacketEligibleAt interface direction hook traffic →
      OuterGrayRestrictions d interface direction cdpOnGray traffic →
      OuterPolicyAllowance d interface.device cdpOnGray traffic →
      d.AcceptsAt interface.id direction hook traffic</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:973
def OuterManagementInitiation (d : Deployment) (traffic : Traffic) : Prop :=
  traffic.trafficClass = .management ∧
    (d.grayWorkstation traffic.originator ∨
      (d.IsLayer traffic.originator .outer ∧ traffic.service ∈ ["logging", "authentication"]))</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:978
def OuterTunnelAllowance (d : Deployment) (device : String) (traffic : Traffic) : Prop :=
  (d.TunnelTraffic traffic ∨ (∃ source destination, d.CarrierInnerPair traffic source destination)) ∧
    ((d.SameLevelInner traffic ∧ d.AppropriateInnerTunnel traffic) ∨
      (d.grayManagementService device traffic ∧ d.GrayManagementTunnel traffic))</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:986
def OuterPolicyAllowance (d : Deployment) (device : String) (cdpOnGray : Bool)
    (traffic : Traffic) : Prop :=
  OuterTunnelAllowance d device traffic ∨
    (cdpOnGray = true ∧ d.IsDevice device .vpn ∧ RevocationHTTP traffic) ∨
    ((traffic.trafficClass = .management ∨ traffic.trafficClass = .control) ∧
      d.policyApproved device traffic)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:993
def OuterGrayRestrictions (d : Deployment) (interface : Interface) (direction : Direction)
    (cdpOnGray : Bool) (traffic : Traffic) : Prop :=
  d.HeaderEligible interface traffic ∧
  (traffic.trafficClass = .management → OuterManagementInitiation d traffic) ∧
  (direction = .inbound → d.reachableSource interface.id traffic.packet.source) ∧
  (traffic.trafficClass = .protectedData → ¬ RevocationHTTP traffic →
    d.SameLevelInner traffic ∨
      (d.grayManagementService interface.device traffic ∧ d.GrayManagementTunnel traffic)) ∧
  (traffic.service = "http" → cdpOnGray = true → d.IsDevice interface.device .vpn →
    traffic.innerRevocation = true)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:88
def msc_outer_gray_interface_policy (d : Deployment) (cdpOnGray : Bool) : Prop :=
  CoreReq_msc_outer_gray_interface_policy { d with focus := none } cdpOnGray</tdn:requirementCode>
    <tdn:requirementStatus>Complete model proof reviewed</tdn:requirementStatus>
    <tdn:requirementTranslation>Outer Gray policies allow the specified same-level Inner tunnels, Gray-management tunnels, approved management or control traffic, and the selected Inner-revocation HTTP exception. Accepted packets also satisfy header restrictions, reachable-source checks on ingress, and the management-initiation restrictions. Every eligible packet meeting the complete modeled allowance and restrictions is accepted at its processing hook. The address, processing, UDP, and policy records must agree.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-040">
    <rdfs:label>Gray Firewall allowlist and cross-level denial</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:1021
def GrayPolicyAllowance (d : Deployment) (interface : Interface) (traffic : Traffic) : Prop :=
  ((d.TunnelTraffic traffic ∨ (∃ source destination, d.CarrierInnerPair traffic source destination)) ∧
    d.SameLevelInner traffic ∧ d.AppropriateInnerTunnel traffic) ∨ RevocationHTTP traffic ∨
    GrayManagementAllowance d interface traffic ∨
    (traffic.trafficClass = .control ∧ d.policyApproved interface.device traffic)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:1034
def GrayFirewallRestrictions (d : Deployment) (interface : Interface) (direction : Direction)
    (traffic : Traffic) : Prop :=
  d.HeaderEligible interface traffic ∧
  (traffic.trafficClass = .management → GrayManagementAllowance d interface traffic) ∧
  (traffic.trafficClass = .protectedData → ¬ RevocationHTTP traffic → d.SameLevelInner traffic) ∧
  (direction = .inbound → d.reachableSource interface.id traffic.packet.source) ∧
  (traffic.service = "http" → traffic.innerRevocation = true) ∧
  ¬ DifferentClassificationVPNs d traffic</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:1043
def CoreReq_msc_gray_firewall_allowlist (d : Deployment) (grayFirewallRequired : Bool) : Prop :=
  d.AddressInventoryCoherent ∧
  (grayFirewallRequired = true → d.ProcessingCoherent ∧ d.UDPBindingsCoherent ∧
    ∀ interface ∈ d.interfaces, d.Relevant interface.device →
      d.IsDevice interface.device .grayFirewall → d.PolicyCoverage interface ∧
        (∀ direction traffic, d.Accepts interface.id direction traffic →
          GrayFirewallRestrictions d interface direction traffic ∧
          GrayPolicyAllowance d interface traffic) ∧
        ∀ direction hook traffic, d.PacketEligibleAt interface direction hook traffic →
          d.GrayForwardPermission interface hook traffic →
          GrayFirewallRestrictions d interface direction traffic →
          GrayPolicyAllowance d interface traffic →
          d.AcceptsAt interface.id direction hook traffic) ∧
  ∀ interface ∈ d.interfaces, d.Relevant interface.device → d.IsDevice interface.device .grayFirewall →
    ∀ direction traffic, DifferentClassificationVPNs d traffic →
      ¬ d.Accepts interface.id direction traffic</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:91
def msc_gray_firewall_allowlist (d : Deployment) (grayFirewallRequired : Bool) : Prop :=
  CoreReq_msc_gray_firewall_allowlist { d with focus := none } grayFirewallRequired</tdn:requirementCode>
    <tdn:requirementStatus>Complete model proof reviewed</tdn:requirementStatus>
    <tdn:requirementTranslation>Gray Firewall policies allow the specified same-level Inner tunnels, Inner-revocation HTTP, approved control traffic, and approved management traffic on a physical management interface. Accepted traffic satisfies header, source-reachability, and classification restrictions. Eligible packets meeting the complete conditions and forwarding permission are accepted. Traffic between Inner VPNs at different classifications is always rejected.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-041">
    <rdfs:label>Control-plane approval, defaults, and service location</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:505
def ControlServiceConfiguration (record : ComponentDutyRecord) (device : Device) : Prop :=
  ∀ service ∈ record.services, service.enabled = true →
    (device.layer = some .inner → service.network = .red) ∧
    (device.layer = some .outer → service.network = .gray) ∧
    ((service.layer = 2 ∧ service.neededForOperation = true) ∨ service.aoApproved = true)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:274
| 41 =&gt; each (fun device record =&gt; ControlServiceConfiguration record device)</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>An enabled control service on an Inner encryptor is attached to Red; on an Outer encryptor it is attached to Gray. Each enabled service is either necessary Layer-2 control traffic or explicitly approved by the AO.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-042">
    <rdfs:label>Layer-specific trusted time synchronization</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:275
| 42 =&gt; each (fun device _ =&gt; TrustedTimeConfiguration records.time device d)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/TrustedClockSynchronization.lean:209
def TimeServiceRecord.ValidUse (record : TimeServiceRecord)
    (observations : TimeObservationInventory) (d : Deployment) (zone : Zone)
    (binding : TimeClockBinding) (use : TimeClockUse) : Prop :=
  record.binding = binding.id ∧ use.binding = binding.id ∧ binding.InScope use ∧
  use.clock = binding.clock ∧ use.clockKind = binding.clockKind ∧ use.process = binding.process ∧
  use.executable = binding.executable ∧
  record.source.Bound d zone ∧ observations.runtime.sourceTrusted record.source ∧
  ∃ configuration ∈ observations.configurations,
    configuration.id = record.configuration ∧
    use.configuration = configuration.id ∧ configuration.clock = binding.clock ∧
    configuration.source = record.source ∧ configuration.adjustmentEnabled = true ∧
    configuration.observer = binding.observer ∧ binding.operatingFrom ≤ configuration.order ∧
    use.source = record.source ∧
    (match configuration.maximumRemainingCorrectionNanoseconds with
      | none =&gt; True
      | some maximum =&gt; ∃ offset, use.remainingCorrectionNanoseconds = some offset ∧
          offset.natAbs ≤ maximum) ∧
    (match configuration.maximumSkewMilliPpm with
      | none =&gt; True
      | some maximum =&gt; ∃ skew, use.skewMilliPpm = some skew ∧ skew ≤ maximum) ∧
    ∃ update ∈ observations.updates,
      update.id = record.update ∧ use.update = update.id ∧
      update.configuration = configuration.id ∧ update.clock = binding.clock ∧
      update.source = record.source ∧ update.operation.Valid ∧
      update.process = configuration.synchronizerProcess ∧
      (match update.operation with
        | .correction _ _ =&gt; True
        | .discipline process =&gt; process = configuration.synchronizerProcess) ∧
      update.observer = binding.observer ∧ configuration.order &lt; update.order ∧
      update.order &lt; use.order ∧
      (∀ later ∈ observations.updates, later.clock = binding.clock →
        later.observer = binding.observer → later.order ≤ use.order →
        later.order ≤ update.order) ∧
      ∀ invalidation ∈ observations.invalidations, invalidation.clock = binding.clock →
        invalidation.observer = binding.observer →
        ¬ (update.order ≤ invalidation.order ∧ invalidation.order ≤ use.order)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/TrustedClockSynchronization.lean:246
def TimeConfigurationForClient (observations : TimeObservationInventory) (d : Deployment)
    (client : TimeClient) (zone : Zone) : Prop :=
  (∃ binding ∈ observations.bindings, binding.client = client) ∧
  ∀ binding ∈ observations.bindings, binding.client = client →
    (∃ use ∈ observations.uses, binding.InScope use) ∧
    ∀ use ∈ observations.uses, binding.InScope use →
      ∃ record ∈ observations.services, record.ValidUse observations d zone binding use</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/TrustedClockSynchronization.lean:254
def TrustedTimeConfiguration (observations : TimeObservationInventory)
    (device : Device) (d : Deployment) : Prop :=
  ∀ client zone, client.component = device.id → client.Required d zone →
    TimeConfigurationForClient observations d client zone</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Each device that requires a trusted clock source must have a recorded clock binding and at least one in-scope clock use. Every such use must match a trusted source in the required zone, an enabled synchronization configuration, and a preceding valid clock update. Configured correction and skew limits must hold, the selected update must be the latest at that use, and no intervening clock invalidation is allowed.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-043">
    <rdfs:label>Default credentials, DNS, and remote bootstrap</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:499
def DefaultAndDNSConfiguration (record : ComponentDutyRecord) : Prop :=
  (∀ mechanism ∈ record.defaults,
    mechanism.removed = true ∨ mechanism.currentValue ≠ mechanism.vendorValue) ∧
  (record.dnsEnabled = true → record.dnsServers ≠ []) ∧ record.automaticRemoteBoot = false ∧
  (record.dnsLookupDisableSelected = true → record.dnsLookupEnabled = false)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:276
| 43 =&gt; context.ConfigurationDefaults subject</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Every recorded vendor-default setting is removed or changed. Enabled DNS has a server list, automatic remote boot is disabled, and selecting the DNS-lookup-disable objective disables lookups.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-044">
    <rdfs:label>Layer-specific administration and management-plane separation</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:522
def ManagementSeparation (record : ComponentDutyRecord) : Prop :=
  (∀ iface ∈ record.managementInterfaces, iface ∉ record.dataInterfaces) ∧
  record.managementPhysicalSeparated = true ∧ record.managementCryptographicSeparated = true ∧
  record.managementACLSeparated = true ∧ record.directNIPRConnection = false</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:527
def ManagementAttachmentConfiguration (records : TechnicalDutyRecords) (d : Deployment) : Prop :=
  records.managementDeployed = true →
  (∃ red ∈ d.devices, red.kind = .workstation ∧
    ∃ interface ∈ d.interfaces, interface.device = red.id ∧ interface.zone = .red ∧
      interface.managementNetwork = true) ∧
  (∃ gray ∈ d.devices, gray.kind = .workstation ∧
    ∃ interface ∈ d.interfaces, interface.device = gray.id ∧ interface.zone = .gray ∧
      interface.managementNetwork = true) ∧
  ∀ device ∈ d.devices, d.Relevant device.id →
    ∀ record ∈ records.components, record.component = device.id →
      ManagementSeparation record ∧
      (∀ iface ∈ record.managementInterfaces, ∃ interface ∈ d.interfaces,
        interface.id = iface ∧ interface.device = device.id ∧ interface.managementNetwork = true) ∧
      record.managementConnections ≠ [] ∧
      ∀ connection ∈ record.managementConnections,
        connection.component = device.id ∧
        (∃ workstation ∈ d.devices, workstation.id = connection.initiatedFromAW ∧
          workstation.kind = .workstation ∧
          ∃ source ∈ d.interfaces, source.device = workstation.id ∧
            source.managementNetwork = true ∧
            ∃ target ∈ d.interfaces, target.id = connection.interface ∧
              target.device = device.id ∧ target.managementNetwork = true ∧
              source.zone = target.zone ∧
              (device.layer = some .inner ∨ device.kind = .innerFirewall →
                target.zone = .red) ∧
              (device.layer = some .outer ∨ device.kind = .grayFirewall →
                target.zone = .gray))</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:277
| 44 =&gt; ManagementAttachmentConfiguration records d</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>When management is deployed, the deployment has both Red and Gray management workstations. Each relevant component has separate management interfaces, physical, cryptographic, and ACL separation, and no direct NIPR connection. Recorded management connections start at a workstation in the same zone. Inner encryptors and Inner Firewalls use Red management; Outer encryptors and Gray Firewalls use Gray management.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-045">
    <rdfs:label>Dedicated, protected, hardened Administrative Workstations</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:555
def WorkstationHostConfiguration (records : TechnicalDutyRecords)
    (record : ComponentDutyRecord) : Prop :=
  (record.awCurrentlyUsed = false → record.awPoweredOnWhenUnused = false) ∧
  ∀ service ∈ records.hostServices, service.host = record.awHost →
    service.service = "administrative-workstation"</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:278
| 45 =&gt; each (fun device record =&gt; device.kind = .workstation →
      WorkstationHostConfiguration records record ∧
      records.external.Confirms .vendorAndLocalHardening (.component device.id) ∧
      records.external.Confirms .protectedFacility (.component device.id))</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>An unused Administrative Workstation must be powered off. Every service recorded on its host must be an administrative-workstation service. The component also needs external confirmation of vendor and local hardening and a protected facility.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-046">
    <rdfs:label>Management transport protection and local exceptions</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:511
def ManagementTransportConfiguration (record : ComponentDutyRecord) : Prop :=
  record.administratorAddresses = record.minimumAdministratorAddresses ∧
  ∀ connection ∈ record.managementConnections,
    connection.interface ∈ record.managementInterfaces ∧
    (connection.directPhysical = true ∨
      connection.protocol ∈ ["ssh", "ipsec", "macsec"] ∨
      (connection.protocol = "tls" ∧ connection.tlsMajor = 1 ∧ 2 ≤ connection.tlsMinor)) ∧
    (connection.crossesBlack = true →
      2 ≤ connection.approvedEncryptionLayers ∧
      (connection.localDedicatedLAN = true → connection.sameVLAN = true))</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:282
| 46 =&gt; each (fun _ record =&gt; ManagementTransportConfiguration record)</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Administrator addresses are limited to the recorded minimum set. Each management connection uses a management interface and either a direct physical connection, SSH, IPsec, MACsec, or TLS 1.2 or later within major version 1. Connections crossing Black use at least two approved encryption layers. A connection marked as a local dedicated LAN must then also remain on the same VLAN.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-047">
    <rdfs:label>Administrator authentication and individual credentials</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:1060
def CoreReq_msc_administrator_authentication (d : Deployment)
    (certificateObjective nistObjective : Bool) (events : List AdminEvent)
    (accounts : List AdministrativeAccount) (sessions : List AdministrativeSession)
    (awAdministrators : List Nat) : Prop :=
  TDN.Requirements.msc_administrator_authentication certificateObjective nistObjective
    events accounts sessions awAdministrators ∧
  ∀ event ∈ events, event.kind = .authentication →
    (certificateObjective = true → d.authority.certificateCNSACompliant event.credential) ∧
    (nistObjective = true → d.authority.authenticationConformsToNIST80063 event.credential)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/ManagementPlaneRequirements.lean:59
def msc_administrator_authentication (certificateObjective nistObjective : Bool)
    (events : List AdminEvent) (accounts : List AdministrativeAccount)
    (sessions : List AdministrativeSession) (awAdministrators : List Nat) : Prop :=
  (∀ event ∈ events, event.kind = .operation →
    ∃ authentication ∈ events,
      MatchingAdministratorAuthentication certificateObjective nistObjective events accounts sessions
        authentication event) ∧
  (∀ account ∈ accounts, account.credential ≠ "" ∧
    (account.workstationAccount = true → account.groupAccount = false)) ∧
  (∀ person ∈ awAdministrators, ∃ account ∈ accounts,
    account.person = person ∧ account.workstationAccount = true) ∧
  ∀ a ∈ accounts, a.workstationAccount = true →
    ∀ b ∈ accounts, b.workstationAccount = true →
      a.person ≠ b.person → a.credential ≠ b.credential</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:94
def msc_administrator_authentication (d : Deployment)
    (certificateObjective nistObjective : Bool) (events : List AdminEvent)
    (accounts : List AdministrativeAccount) (sessions : List AdministrativeSession)
    (awAdministrators : List Nat) : Prop :=
  CoreReq_msc_administrator_authentication { d with focus := none } certificateObjective
    nistObjective events accounts sessions awAdministrators</tdn:requirementCode>
    <tdn:requirementStatus>Complete model proof reviewed</tdn:requirementStatus>
    <tdn:requirementTranslation>Every administrative operation has a matching authentication event satisfying the session, account, and ordering conditions. Account credentials are nonempty. Workstation accounts are individual, every listed workstation administrator has one, and different people use different credentials. Selected certificate and NIST objectives add the corresponding credential-approval conditions.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-048">
    <rdfs:label>Authorized provisioning and initial certificate requests</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:562
def ProvisioningConfiguration (records : TechnicalDutyRecords) (d : Deployment)
    (component : String) : Prop :=
  (∀ certificate ∈ records.certificates, certificate.subject = component →
    certificate.vendorDefault = false → certificate.selfSigned = false →
    certificate.proprietary = false →
    ∃ provision ∈ records.provisioning, provision.component = component ∧
      provision.certificate = certificate.id) ∧
  ∀ provision ∈ records.provisioning, provision.component = component →
    d.authority.securityAdministrator provision.administrator ∧
    provision.keyGeneratedOnComponent = true ∧ provision.csr ≠ "" ∧
    provision.securePhysicalArea = true ∧ provision.outOfBand = true ∧
    provision.provisionedAt &lt; provision.firstUsedAt ∧
    (∀ authentication ∈ records.authentications,
      authentication.input.credential = provision.certificate →
      provision.provisionedAt &lt; authentication.input.time) ∧
    (∃ certificate ∈ records.certificates, certificate.id = provision.certificate ∧
      certificate.subject = component ∧ certificate.issuer = provision.ca) ∧
    (∃ authority ∈ d.devices, authority.id = provision.ca ∧
      authority.kind = .certificationAuthority ∧ d.keyManagementCA component authority.id)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:283
| 48 =&gt; each (fun device _ =&gt; ProvisioningConfiguration records d device.id)</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Every eligible non-default certificate has a provisioning record. Each provisioning record names an authorized administrator, a key generated on the component, a nonempty certificate request, and a secure out-of-band physical setup. Provisioning precedes first use and recorded authentications with the certificate. The certificate and its assigned CA must match the component and deployment records.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-049">
    <rdfs:label>Personnel clearance and Outer administration</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:284
| 49 =&gt; external [.authorizedAdministratorClearance, .outerAdministratorClearance]</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>The context needs external confirmations of the required administrator clearances, including Outer administration.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-050">
    <rdfs:label>SIEM placement, collection, alerting, and log transport</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:588
def SIEMConfiguration (records : TechnicalDutyRecords) (d : Deployment) : Prop :=
  ∀ device ∈ d.devices, d.Relevant device.id → ∀ zone,
    ComponentMonitoringZone d device zone →
    (∃ siem ∈ d.devices, siem.kind = .siem ∧
      ∃ interface ∈ d.interfaces, interface.device = siem.id ∧
        (interface.zone = zone ∨ (zone = .gray ∧ interface.zone = .red))) →
    ∀ source ∈ records.components, source.component = device.id →
    ∃ receiver ∈ d.devices, receiver.kind = .siem ∧ source.siem = some receiver.id ∧
      ∃ interface ∈ d.interfaces, interface.device = receiver.id ∧
        source.siemZone = some interface.zone ∧
        (interface.zone = zone ∨
          (zone = .gray ∧ interface.zone = .red ∧ source.approvedCrossDomainPath = true)) ∧
        source.loggingEnabled = true ∧
        ∃ target ∈ records.components, target.component = receiver.id ∧
          device.id ∈ target.collectedLogSources ∧ device.id ∈ target.analyzedLogSources ∧
          target.alerts ≠ [] ∧
          (zone = .red → source.flowLoggingEnabled = true ∧
            device.id ∈ target.collectedFlowSources ∧ device.id ∈ target.analyzedFlowSources) ∧
          (device.layer = some .outer ∨ device.kind = .grayFirewall →
            "unexpected-boundary-traffic-drop" ∈ target.alerts)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:285
| 50 =&gt; SIEMConfiguration records d</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>When a SIEM is available for the required monitoring zone, the component must log to a recorded SIEM that collects and analyzes its logs and has alerts. Red monitoring also collects and analyzes flows. Moving Gray logs to a Red SIEM needs an approved cross-domain path. Outer components and Gray Firewalls need an unexpected-boundary-traffic-drop alert.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-051">
    <rdfs:label>Cross Domain Solution approval conditions</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:286
| 51 =&gt; ∀ solution ∈ records.crossDomainSolutions,
      records.external.Confirms .crossDomainDoDI (.component solution) ∧
      records.external.Confirms .crossDomainConnectionGuide (.component solution) ∧
      records.external.Confirms .crossDomainOfficialBaseline (.component solution)</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>Every listed Cross Domain Solution needs external confirmations of the specified DoDI, connection-guide, and official-baseline requirements.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-052">
    <rdfs:label>Physical protection, authorized access, and disposal</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:290
| 52 =&gt; each (fun device _ =&gt;
      (device.kind ≠ .outerFirewall →
        records.external.Confirms .grayPhysicalProtection (.component device.id)) ∧
      records.external.Confirms .authorizedPhysicalAccess (.component device.id) ∧
      records.external.Confirms .classifiedDisposalOrAODeclassification (.component device.id) ∧
      (device.kind = .macsec →
        records.external.Confirms .macsecConfigurationProtection (.component device.id)))</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>Components need external confirmations for authorized physical access and classified disposal or approved declassification. Every component except an Outer Firewall also needs Gray physical-protection confirmation; MACsec components need configuration-protection confirmation.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-053">
    <rdfs:label>Parallel Inner components and distinct Outer internal interfaces</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:297
| 53 =&gt; (∀ first ∈ records.attachments, ∀ second ∈ records.attachments,
      first.outer = second.outer → first.inner ≠ second.inner →
      first.serialPredecessor = none ∧ second.serialPredecessor = none ∧
      first.vlanTrunk = false ∧ second.vlanTrunk = false ∧
      (first.redNetwork ≠ second.redNetwork →
        first.outerPhysicalInterface ≠ second.outerPhysicalInterface))</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Inner components sharing an Outer must be parallel: no serial predecessor and no VLAN trunk in the recorded attachments. Distinct Red networks must use distinct Outer physical interfaces.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-054">
    <rdfs:label>Interoperable components across communicating sites</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:1162
def CoreReq_msc_site_interoperability {S A : Type} (d : Deployment) (model : ForwardingModel S A)
    (requiredSitePairs : List (String × String)) (selected : List Interoperation)
    (domain : PayloadDomain) : Prop :=
  model.CoversDeployment d ∧ RequiredSitePairsBound d requiredSitePairs ∧
  SiteLayerInteroperationCoverage requiredSitePairs selected ∧
  InteroperationInventory d selected ∧ InteroperationTransfers d model selected domain</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:101
def msc_site_interoperability {S A : Type} (d : Deployment) (model : ForwardingModel S A)
    (requiredSitePairs : List (String × String)) (selected : List Interoperation)
    (domain : PayloadDomain) : Prop :=
  CoreReq_msc_site_interoperability { d with focus := none } model requiredSitePairs selected domain</tdn:requirementCode>
    <tdn:requirementStatus>Complete proof unfinished</tdn:requirementStatus>
    <tdn:requirementTranslation>Required site pairs must be bound to the deployment and have an interoperation choice for each layer. Choices cover intended peers and recorded tunnels. For each relevant choice, matching forward and reverse tunnels must support the modeled payload domain in both directions.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-055">
    <rdfs:label>Firewall requirements when combining capability packages</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:303
| 55 =&gt; (records.combinedSolutionRequiresGrayFirewall = true →
      ∃ firewall ∈ d.devices, firewall.kind = .grayFirewall) ∧
      (records.combinedEndUserSolution = true ↔ context.companionFirewalls ≠ []) ∧
      ∀ companion ∈ context.companionFirewalls, companion.Requirements d records</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>Combined solutions must include a Gray Firewall when required. A combined end-user solution must have companion-firewall records, and every such record must satisfy its associated requirements.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-056">
    <rdfs:label>Approved physical paths out of Red Networks</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CoreMscRequirements.lean:1169
def RedEgressCore (d : Deployment)
    (red outside : String → Prop) (conformingMSC aoApprovedProtection : String → Prop) : Prop :=
  (∀ solution, aoApprovedProtection solution → d.authority.aoApprovedTransitSolution solution) ∧
  ∀ source destination, red source → outside destination →
    ¬ Relation.ReflTransGen (Waypointing.Avoiding d.DeviceAdjacent
      (fun node =&gt; conformingMSC node ∨ aoApprovedProtection node)) source destination</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:106
def msc_approved_red_egress_paths {S A : Type} (d : Deployment)
    (red outside : String → Prop) (conformingMSC aoApprovedProtection : String → Prop)
    (solutions : List (MscComplianceContext S A)) : Prop :=
  MSCReferencesClosed solutions ∧
  (∀ solution, conformingMSC solution → ∃ context ∈ solutions,
    context.solution = solution ∧ context.AllApplicableDuties (.entireSolution solution)) ∧
  RedEgressCore { d with focus := none } red outside conformingMSC aoApprovedProtection</tdn:requirementCode>
    <tdn:requirementStatus>Complete proof unfinished</tdn:requirementStatus>
    <tdn:requirementTranslation>Every modeled Red-to-outside path must pass through a conforming MSC solution or approved alternative protection. Approval must be backed by the authority record. Referenced MSC solutions must have supplied contexts satisfying all applicable duties, and their further MSC references must be accounted for.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-057">
    <rdfs:label>Operational security updates and TEMPEST policy</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:307
| 57 =&gt; each (fun device _ =&gt;
      ∀ duty ∈ [.aoVirusUpdatePolicy, .criticalPatchTesting, .localPatchingPolicy, .tempest],
        records.external.Confirms duty (.component device.id))</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>Each component needs external confirmations of the required antivirus-update policy, critical-patch testing, local patching policy, and TEMPEST duties.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-058">
    <rdfs:label>Hardware inventory and available baseline configuration</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:310
| 58 =&gt; each (fun device _ =&gt;
      records.external.Confirms .authorizedHardwareInventory (.component device.id) ∧
      records.external.Confirms .baselineAvailableToAuditor (.component device.id))</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Each component needs external confirmations that its hardware inventory is authorized and its baseline configuration is available to the auditor.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-059">
    <rdfs:label>Procurement documentation excludes classified-protection purpose</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:313
| 59 =&gt; external [.procurementPurposeExclusion]</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>The context needs external confirmation that procurement documentation follows the restriction on mentioning the classified-protection purpose.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-060">
    <rdfs:label>Annual and NSA-authorized compliance audits</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:314
| 60 =&gt; external [.nsaAuditPermission, .nsaAuditCooperation, .annualAOAudit, .annualAuditResultsReview]</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>The context needs external confirmations for NSA audit permission and cooperation, the annual AO audit, and review of its results.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-061">
    <rdfs:label>Registration, approval, annual renewal, and version updates</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:315
| 61 =&gt; external [.nsaRegistrationApproval, .aoRegistrationPackage, .annualRenewal,
      .registrationChanges, .versionMigrationDeadline]</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>The context needs external confirmations for registration approval, the AO package, annual renewal, reported changes, and the version-migration deadline.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-062">
    <rdfs:label>Audit retention, storage monitoring, backup, and continuity</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:628
def AuditRetentionConfiguration (records : TechnicalDutyRecords) (component : String) : Prop :=
  (∀ event ∈ records.audits, event.component = component →
    event.time + 365 * 86400 ≤ event.retainedUntil ∧
    ∃ backup ∈ event.backedUpAt, event.time ≤ backup) ∧
  (∃ storage ∈ records.storage, storage.component = component ∧
    (∀ year quarter,
      CalendarQuarterStart year quarter &lt; storage.operatingUntil →
      storage.operatingFrom &lt; CalendarQuarterEnd year quarter →
      ∃ checked ∈ storage.capacityCheckedAt,
        CalendarQuarterStart year quarter ≤ checked ∧
        checked &lt; CalendarQuarterEnd year quarter ∧
        storage.operatingFrom ≤ checked ∧ checked ≤ storage.operatingUntil) ∧
    storage.warningOnLowSpace = true ∧ storage.offloadEnabled = true ∧
    storage.overflowHandling ≠ "" ∧ storage.powerLossHandling ≠ "") ∧
  records.external.Confirms .frequentAuditOffload (.component component)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:317
| 62 =&gt; each (fun device _ =&gt; AuditRetentionConfiguration records device.id) ∧
      external [.incidentResponseGuidance, .auditLowSpacePlan, .auditOffloadPlan,
        .auditOverflowPlan, .auditPowerPlan]</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>Recorded audit events are retained for at least 365 days and have a backup at or after the event. Storage capacity is checked during every calendar quarter overlapping operation. Low-space warning and offload are enabled, and overflow and power-loss handling are recorded. Frequent offload and the required incident-response and storage plans also need external confirmation.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-063">
    <rdfs:label>Infrastructure authentication alternatives</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:320
| 63 =&gt; each (fun _ record =&gt; if record.passwordAlternativeSelected then
      record.domainAuthenticationService.isSome = true else 112 ≤ record.infrastructureSecretEntropyBits)</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>If the password alternative is selected, a domain authentication service must be recorded. Otherwise, the recorded infrastructure secret must have at least 112 bits of entropy.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-064">
    <rdfs:label>Incident triggers, required report fields, and reporting deadline</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:322
| 64 =&gt; external [.incidentDeadlineAndChannel, .incidentRequiredFields,
      .reportSecurityFailure, .reportClassifiedCompromise, .reportMaliciousGrayTraffic,
      .reportUnauthorizedClassifiedAccess, .reportUnauthorizedDestination,
      .reportMaliciousConfigurationChange, .reportUnauthorizedPrivilegeEscalation,
      .reportConcurrentCertificateReuse, .reportMaliciousPhysicalTampering,
      .reportProtectionLayerFailure, .reportSignificantServiceDegradation,
      .reportOuterConnectionDiscrepancy, .reportInnerConnectionDiscrepancy]</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>The context needs external confirmations for the reporting deadline and channel, required report fields, and each listed kind of security or service incident.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-065">
    <rdfs:label>Separation of administrative and auditing personnel</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:329
| 65 =&gt; external [.differentAdministratorAndAuditor, .differentRedAndGrayAdministrators] ∧
      (records.optionalRoleMACSelected = true → external [.optionalRoleMAC])</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>The context needs external confirmations that administrator and auditor duties are separated and that Red and Gray administrators are different. Selecting optional role-based mandatory access control adds its confirmation requirement.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-066">
    <rdfs:label>Personnel training and physical tamper inspections</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:331
| 66 =&gt; external [.securityTraining, .tamperInspection]</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>The context needs external confirmations of security training and physical tamper inspection.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-067">
    <rdfs:label>Revocation or CAK destruction before disposal</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:644
def RevocationBeforeDisposal (record : ComponentDutyRecord)
    (usesCertificate usesCAK : Bool) : Prop :=
  ∀ disposed, record.disposedAt = some disposed →
    (usesCertificate = true →
      ∃ initiated, record.credentialRevocationInitiatedAt = some initiated ∧ initiated &lt; disposed) ∧
    (usesCAK = true →
      ∃ initiated, record.cakDestructionInitiatedAt = some initiated ∧ initiated &lt; disposed)</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:332
| 67 =&gt; each (fun device record =&gt; RevocationBeforeDisposal record
      (records.certificates.any (fun certificate =&gt; certificate.subject == device.id))
      (d.preSharedCAKAuthenticated device.id))</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>For a recorded disposal, certificate-revocation initiation must precede disposal when certificates are used. CAK-destruction initiation must precede disposal when a pre-shared CAK is used.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-068">
    <rdfs:label>Security Administrator operational duties</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:335
| 68 =&gt; external [.administratorMaintainsMonitorsControls, .administratorLatestCriticalUpdates,
      .administratorIncidentDocumentationReporting, .administratorLogisticSupport,
      .administratorAuxiliaryDeviceDefenses, .administratorVersionCompliance]</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>The context needs external confirmations of the Security Administrator's maintenance, updates, incident reporting, logistical support, auxiliary-device defenses, and version-compliance duties.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-069">
    <rdfs:label>Auditor review duties and access boundary</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:338
| 69 =&gt; external [.auditorReviewsActionsAndEvents, .auditorOnlyAdministrationAccess,
      .auditorManagesLogs, .auditorIncidentDocumentationReporting, .auditorCapabilitySurvey]</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>The context needs external confirmations of the Auditor's review, restricted administration access, log management, incident reporting, and capability-survey duties.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-070">
    <rdfs:label>Optional Integrator involvement and duty scope</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:340
| 70 =&gt; True</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>The current shared Lean branch is True, so it adds no condition for optional Integrator duties. There is no substantive proof obligation in that branch.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-071">
    <rdfs:label>AO authorization evidence and lifecycle control</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:341
| 71 =&gt; external [.assessmentAuthorization, .assessmentResultsToAO, .aoImplementationVerification,
      .lifecycleAOConfigurationControl, .lifecycleAORequiredUpdates,
      .externalEngagementVariants, .compromiseRevocation, .nsaRiskAssessmentToAO]</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>The context needs external confirmations for assessment and authorization, AO review and implementation verification, lifecycle configuration and update control, external engagements, compromise revocation, and risk assessment.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-072">
    <rdfs:label>Whole-solution testing and preserved results</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:344
| 72 =&gt; external [.testingAnnex, .capabilityTestCoverage, .blackGrayBoxTests,
      .testDiscrepancyDocumentation, .testBaselineDocumentation,
      .testPlanAOAdditionalRequirements, .testArtifactsAndAOReport]</tdn:requirementCode>
    <tdn:requirementStatus>Assigned to direct checks</tdn:requirementStatus>
    <tdn:requirementTranslation>The context needs external confirmations that the required tests, coverage, discrepancy records, baseline, test plan, and preserved results and AO report exist.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-073">
    <rdfs:label>Objective software and firmware signing algorithms</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligationRecords.lean:652
def SigningConfiguration (record : ComponentDutyRecord) : Prop :=
  record.signatureObjectiveSelected = true →
    record.softwareSigningAlgorithms ≠ [] ∧
    ∀ algorithm ∈ record.softwareSigningAlgorithms, algorithm.Approved</tdn:requirementCode>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:347
| 73 =&gt; each (fun _ record =&gt; SigningConfiguration record)</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>When the signing objective is selected, the record contains at least one software-signing algorithm and every listed algorithm satisfies the modeled Approved condition.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-074">
    <rdfs:label>Redundant component and load-balancing permission</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/MasterMscRequirementSpecs.lean:114
def msc_redundant_component_permission {S A : Type} (context : MscComplianceContext S A)
    (redundant : String → Prop) : Prop :=
  ∀ device ∈ context.deployment.devices, redundant device.id →
    (¬ context.deployment.OrdinaryGray device.id ∨
      context.deployment.standaloneEncapsulator device.id) →
    context.AllApplicableDuties (.deviceComponent device.id)</tdn:requirementCode>
    <tdn:requirementStatus>Complete proof unfinished</tdn:requirementStatus>
    <tdn:requirementTranslation>Every selected redundant component must satisfy all applicable component duties whenever it is outside ordinary Gray scope or is a standalone encapsulator. The condition applies separately to each selected redundant device.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-075">
    <rdfs:label>Optional additional controls and screening-router scope</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:349
| 75 =&gt; (∀ router ∈ records.selectedScreeningRouters,
      ∃ device ∈ d.devices, device.id = router ∧ device.layer = none)</tdn:requirementCode>
    <tdn:requirementStatus>Permission or applicability condition</tdn:requirementStatus>
    <tdn:requirementTranslation>Every selected screening router must exist in the device inventory and have no encryption-layer assignment.</tdn:requirementTranslation>
  </rdf:Description>
  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:RG-076">
    <rdfs:label>CP user legal undertaking and disclaimer</rdfs:label>
    <tdn:requirementCode>TDN/Requirements/CsfcRoleObligations.lean:351
| 76 =&gt; external [.legalUndertaking]</tdn:requirementCode>
    <tdn:requirementStatus>Requires external evidence</tdn:requirementStatus>
    <tdn:requirementTranslation>The context needs external confirmation of the legal undertaking. The Lean branch records that confirmation as an external input.</tdn:requirementTranslation>
  </rdf:Description>
