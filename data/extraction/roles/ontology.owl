  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:ROLE-remotely-managed-device">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment>Management-mode role defined by methods other than a local hardwired AW connection.</rdfs:comment>
