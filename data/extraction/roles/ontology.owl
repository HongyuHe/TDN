  <rdf:Description rdf:about="urn:tdn:csfc:msc:roles:ROLE-ike-initiator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class" />
    <rdfs:comment>Protocol endpoint role that sends the initiator messages in the described IKE_SA_INIT exchange. The source does not identify Bob or Alice as that endpoint.</rdfs:comment>
    <rdfs:label>IKEv2 initiator</rdfs:label>
    <rdfs:subClassOf rdf:resource="urn:tdn:csfc:msc:roles:ExtractedRole" />
    <skos:altLabel>initiator</skos:altLabel>
