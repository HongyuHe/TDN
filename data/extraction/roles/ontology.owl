    <tdn:directRequirement rdf:resource="urn:tdn:csfc:msc:roles:RG-063" />
    <tdn:leanExpression>Device.infrastructure</tdn:leanExpression>
    <tdn:leanMapping>The device record has an infrastructure flag. Flow.Valid requires both encryption endpoints to carry that flag.</tdn:leanMapping>
    <tdn:leanReference>Device at TDN/Requirements/MscComplianceSchema.lean:18</tdn:leanReference>
    <tdn:leanReference>Flow.Valid at TDN/Requirements/CoreMscRequirements.lean:21</tdn:leanReference>
    <tdn:leanRepresentation>direct</tdn:leanRepresentation>
    <tdn:roleId>ROLE-infrastructure-component</tdn:roleId>
    <tdn:roleKind>device_or_service_role</tdn:roleKind>
    <tdn:sourceUnit rdf:resource="urn:tdn:csfc:source:CSFC-MSC-1.3.0-4e40e3d83708:p030:u003.s003" />
