<urn:tdn:csfc:source:CSFC-MSC-1.3.0-4e40e3d83708:p007:u005> rdfs:label "CSFC-MSC-1.3.0-4e40e3d83708:p007:u005" .
<urn:tdn:csfc:source:CSFC-MSC-1.3.0-4e40e3d83708:p007:u005> tdn:pdfPages "7" .
